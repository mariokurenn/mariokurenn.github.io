---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, publishDate, updatedDate, author, category, tags, image, imageAlt, seoKeyword, canonicalURL } = post.data;

const siteURL = 'https://conversionrate-expert.com';
const postURL = new URL(`/blog/${post.slug}/`, siteURL).href;

const blogPostSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    name: author,
    url: `${siteURL}/about/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'conversionrate-expert.com',
    url: siteURL,
  },
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  url: postURL,
  mainEntityOfPage: postURL,
  keywords: tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteURL}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: postURL },
  ],
};

const categorySlug = category.toLowerCase().replace(/\s+/g, '-').replace(/\//g, '-');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

const formattedUpdated = updatedDate
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedDate)
  : null;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  canonicalURL={canonicalURL ?? postURL}
  jsonLd={[blogPostSchema, breadcrumbSchema]}
>
  <article class="blog-post" itemscope itemtype="https://schema.org/BlogPosting">
    <!-- Header -->
    <header class="blog-post__header">
      <div class="container blog-post__header-inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <a href={`/blog/category/${categorySlug}/`}>{category}</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">{title}</span>
        </nav>

        <a href={`/blog/category/${categorySlug}/`} class="badge badge--accent" style="margin-bottom: var(--space-4); display: inline-block;">
          {category}
        </a>

        <h1 class="blog-post__title" itemprop="headline">{title}</h1>

        <div class="blog-post__meta">
          <div class="blog-post__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <div class="blog-post__author-avatar" aria-hidden="true">
              {author.charAt(0)}
            </div>
            <div>
              <span class="blog-post__author-name" itemprop="name">{author}</span>
              <div class="blog-post__meta-details">
                <time datetime={publishDate.toISOString()} itemprop="datePublished">{formattedDate}</time>
                {formattedUpdated && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>Updated <time datetime={updatedDate!.toISOString()} itemprop="dateModified">{formattedUpdated}</time></span>
                  </>
                )}
                <span aria-hidden="true">·</span>
                <span>{readingTime} min read</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content layout -->
    <div class="blog-post__layout container">
      <!-- Table of Contents (desktop sticky) -->
      <aside class="blog-post__toc" aria-label="Table of contents">
        <div class="toc">
          <p class="toc__title">On this page</p>
          <nav id="toc-nav" aria-label="Page sections">
            <!-- JS populated -->
          </nav>
        </div>
      </aside>

      <!-- Article body -->
      <div class="blog-post__body">
        <div class="prose" itemprop="articleBody">
          <slot />
        </div>

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="blog-post__tags" aria-label="Article tags">
            <span class="blog-post__tags-label">Tags:</span>
            {tags.map((tag) => (
              <span class="badge badge--surface">{tag}</span>
            ))}
          </div>
        )}

        <!-- Author bio -->
        <div class="author-bio" itemscope itemtype="https://schema.org/Person">
          <div class="author-bio__avatar" aria-hidden="true">D</div>
          <div>
            <p class="author-bio__name" itemprop="name">Darko</p>
            <p class="author-bio__role">CRO Specialist & Founder</p>
            <p class="author-bio__bio">
              Darko has been running A/B tests and conversion optimization programs since 2018.
              He's helped 50+ businesses grow revenue without increasing ad spend. When he's not
              analyzing funnels, he's writing about CRO on this blog.
            </p>
          </div>
        </div>

        <!-- CTA block -->
        <div class="blog-post__cta-block">
          <p class="blog-post__cta-eyebrow">Want us to apply this to your site?</p>
          <h2 class="blog-post__cta-title">Get a Free CRO Audit</h2>
          <p class="blog-post__cta-body">
            We'll analyze your site, find the biggest conversion leaks, and hand you a
            prioritized action plan — completely free.
          </p>
          <a href="/contact/" class="btn btn--primary">
            Book Your Free Audit
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post__header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .blog-post__header-inner {
    max-width: 780px;
  }

  .blog-post__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .blog-post__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .blog-post__author-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: var(--text-lg);
    color: white;
    flex-shrink: 0;
  }

  .blog-post__author-name {
    font-weight: 600;
    font-size: var(--text-sm);
    display: block;
  }

  .blog-post__meta-details {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    flex-wrap: wrap;
  }

  /* Two-column layout */
  .blog-post__layout {
    display: grid;
    grid-template-columns: var(--toc-width) 1fr;
    gap: var(--space-16);
    align-items: start;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  /* TOC */
  .blog-post__toc {
    position: sticky;
    top: 90px;
  }

  .toc {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .toc__title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  :global(#toc-nav a) {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding: var(--space-1) 0;
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3));
    transition: color var(--transition-fast), border-color var(--transition-fast);
    text-decoration: none;
    line-height: 1.4;
  }

  :global(#toc-nav a:hover),
  :global(#toc-nav a.is-active) {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  :global(#toc-nav .toc-h3) {
    padding-left: calc(var(--space-3) * 2);
    margin-left: calc(-1 * var(--space-3));
    font-size: var(--text-xs);
  }

  /* Tags */
  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .blog-post__tags-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  /* Author bio */
  .author-bio {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-10);
  }

  .author-bio__avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: var(--text-xl);
    color: white;
    flex-shrink: 0;
  }

  .author-bio__name {
    font-weight: 700;
    margin-bottom: 2px;
  }

  .author-bio__role {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .author-bio__bio {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* CTA block */
  .blog-post__cta-block {
    background: linear-gradient(135deg, rgba(255, 77, 0, 0.08) 0%, rgba(255, 77, 0, 0.04) 100%);
    border: 1px solid rgba(255, 77, 0, 0.2);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-top: var(--space-10);
  }

  .blog-post__cta-eyebrow {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .blog-post__cta-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
  }

  .blog-post__cta-body {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .blog-post__layout {
      grid-template-columns: 1fr;
    }

    .blog-post__toc {
      display: none;
    }
  }
</style>

<script>
  // Build TOC from headings
  const tocNav = document.getElementById('toc-nav');
  const headings = document.querySelectorAll<HTMLElement>('.prose h2, .prose h3');

  if (tocNav && headings.length > 0) {
    const links: HTMLAnchorElement[] = [];

    headings.forEach((heading) => {
      if (!heading.id) return;
      const level = heading.tagName === 'H2' ? 'h2' : 'h3';
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent ?? '';
      link.className = `toc-${level}`;
      tocNav.appendChild(link);
      links.push(link);
    });

    // Scroll spy
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute('id');
          const link = tocNav.querySelector<HTMLAnchorElement>(`a[href="#${id}"]`);
          if (link) {
            link.classList.toggle('is-active', entry.isIntersecting);
          }
        });
      },
      { rootMargin: '-20% 0% -70% 0%' }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>
