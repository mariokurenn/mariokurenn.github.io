---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
  relatedPosts?: CollectionEntry<'blog'>[];
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const { post, readingTime, relatedPosts = [], prevPost = null, nextPost = null } = Astro.props;
const { title, description, publishDate, updatedDate, author, category, tags, image, imageHero, imageAlt, seoKeyword, seoTitle, canonicalURL, faqs, howTo } = post.data;
const heroImage = imageHero ?? image;

const siteURL = 'https://grow-conversions.com';
const postURL = new URL(`/blog/${post.slug}/`, siteURL).href;
const authorURL = `${siteURL}/author/mario-kuren/`;
const wordCount = post.body.trim().split(/\s+/).length;

const blogPostSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    '@id': authorURL,
    name: author,
    url: authorURL,
    jobTitle: 'CRO Specialist & Founder',
    knowsAbout: ['Conversion Rate Optimization', 'A/B Testing', 'Landing Page Design'],
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteURL}/#organization`,
    name: 'grow-conversions.com',
    url: siteURL,
    logo: {
      '@type': 'ImageObject',
      url: `${siteURL}/favicon.svg`,
    },
  },
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  url: postURL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postURL },
  keywords: tags.join(', '),
  wordCount,
  timeRequired: `PT${readingTime}M`,
  articleSection: category,
  ...(image ? {
    image: {
      '@type': 'ImageObject',
      url: image.startsWith('http') ? image : `${siteURL}${image}`,
      description: imageAlt ?? title,
    },
  } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteURL}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: postURL },
  ],
};

const categorySlug = category.toLowerCase().replace(/\s+/g, '-').replace(/\//g, '-');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(publishDate);

const formattedUpdated = updatedDate
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedDate)
  : null;

const formatRelDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  ogType="article"
  ogImage={image}
  canonicalURL={canonicalURL ?? postURL}
  jsonLd={[
    blogPostSchema,
    breadcrumbSchema,
    ...(howTo ? [{
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: howTo.name,
      ...(howTo.description ? { description: howTo.description } : {}),
      step: howTo.steps.map((s) => ({
        '@type': 'HowToStep',
        name: s.name,
        text: s.text,
      })),
    }] : []),
    ...(faqs && faqs.length > 0 ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    }] : []),
  ]}
>
  <!-- Article-specific OG meta tags -->
  <meta slot="head" property="article:published_time" content={publishDate.toISOString()} />
  <meta slot="head" property="article:modified_time" content={(updatedDate ?? publishDate).toISOString()} />
  <meta slot="head" property="article:author" content={authorURL} />
  <meta slot="head" property="article:section" content={category} />
  {tags.map((tag) => <meta slot="head" property="article:tag" content={tag} />)}

  <!-- Reading progress bar -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true" role="progressbar" aria-label="Reading progress"></div>

  <!-- Mobile TOC -->
  <div class="mobile-toc" id="mobile-toc" aria-hidden="true">
    <div class="mobile-toc__backdrop" id="mobile-toc-backdrop"></div>
    <div class="mobile-toc__drawer" role="dialog" aria-label="Table of contents">
      <div class="mobile-toc__header">
        <span class="mobile-toc__title">On this page</span>
        <button class="mobile-toc__close" id="mobile-toc-close" aria-label="Close table of contents">✕</button>
      </div>
      <nav id="mobile-toc-nav" aria-label="Page sections"></nav>
    </div>
  </div>
  <button class="mobile-toc__trigger" id="mobile-toc-trigger" aria-label="Open table of contents" aria-expanded="false">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="15" y2="12"/><line x1="3" y1="18" x2="18" y2="18"/>
    </svg>
    Contents
  </button>

  <article class="blog-post" itemscope itemtype="https://schema.org/BlogPosting">
    <!-- Header -->
    <header class="blog-post__header">
      <div class="container ">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <a href={`/blog/category/${categorySlug}/`}>{category}</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">{title}</span>
        </nav>

        <a href={`/blog/category/${categorySlug}/`} class="badge badge--accent" style="margin-bottom: var(--space-4); display: inline-block;">
          {category}
        </a>

        <h1 class="blog-post__title" itemprop="headline">{title}</h1>

        <div class="blog-post__meta">
          <div class="blog-post__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <a href="/author/mario-kuren/" class="blog-post__author-link" aria-label={`Author: ${author}`}>
              <div class="blog-post__author-avatar" aria-hidden="true">
                <img src="/images/avatars/mario-sm.webp" alt={author} width="44" height="44" loading="eager" decoding="async" />
              </div>
            </a>
            <div>
              <a href="/author/mario-kuren/" class="blog-post__author-name" itemprop="name">{author}</a>
              <div class="blog-post__meta-details">
                <time datetime={publishDate.toISOString()} itemprop="datePublished">{formattedDate}</time>
                {formattedUpdated && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>Updated <time datetime={updatedDate!.toISOString()} itemprop="dateModified">{formattedUpdated}</time></span>
                  </>
                )}
                <span aria-hidden="true">·</span>
                <span>{readingTime} min read</span>
                <span aria-hidden="true">·</span>
                <span>{wordCount.toLocaleString()} words</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Hero image -->
    {heroImage && (
      <div class="blog-post__hero">
        <div class="container">
          <img
            src={heroImage}
            alt={imageAlt ?? title}
            class="blog-post__hero-img"
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    )}

    <!-- Main content layout -->
    <div class="blog-post__layout container">
      <!-- Sidebar: TOC + sticky CTA -->
      <aside class="blog-post__toc" aria-label="Table of contents">
        <div class="toc">
          <p class="toc__title">On this page</p>
          <nav id="toc-nav" aria-label="Page sections">
            <!-- JS populated -->
          </nav>
        </div>

        <!-- Sidebar CTA -->
        <div class="sidebar-cta">
          <p class="sidebar-cta__eyebrow">Free for your site</p>
          <p class="sidebar-cta__title">Get a Free CRO Audit</p>
          <p class="sidebar-cta__body">
            Find out exactly what's killing your conversions — free 47-point audit, no strings.
          </p>
          <a href="/contact/" class="btn btn--primary sidebar-cta__btn">
            Book Free Audit
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <p class="sidebar-cta__note">Free · No credit card · 24h response</p>
        </div>
      </aside>

      <!-- Article body -->
      <div class="blog-post__body" style="min-width:0;overflow-x:hidden;">
        <div class="prose" itemprop="articleBody">
          <slot />
        </div>

        <!-- FAQ section (AI-citeable Q&A pairs) -->
        {faqs && faqs.length > 0 && (
          <section class="post-faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Frequently Asked Questions</h2>
            <div class="post-faq__list">
              {faqs.map(({ question, answer }) => (
                <details class="post-faq__item">
                  <summary class="post-faq__q">{question}</summary>
                  <p class="post-faq__a">{answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="blog-post__tags" aria-label="Article tags">
            <span class="blog-post__tags-label">Tags:</span>
            {tags.map((tag) => (
              <span class="badge badge--surface">{tag}</span>
            ))}
          </div>
        )}

        <!-- Prev / Next navigation -->
        {(prevPost || nextPost) && (
          <nav class="post-nav" aria-label="Post navigation">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}/`} class="post-nav__item post-nav__item--prev">
                <span class="post-nav__label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                  Previous
                </span>
                <span class="post-nav__title">{prevPost.title}</span>
              </a>
            ) : <div />}
            {nextPost ? (
              <a href={`/blog/${nextPost.slug}/`} class="post-nav__item post-nav__item--next">
                <span class="post-nav__label">
                  Next
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
                <span class="post-nav__title">{nextPost.title}</span>
              </a>
            ) : <div />}
          </nav>
        )}

        <!-- Author bio -->
        <div class="author-bio" itemscope itemtype="https://schema.org/Person">
          <a href="/author/mario-kuren/" class="author-bio__avatar-link" aria-hidden="true">
            <div class="author-bio__avatar">
            <img src="/images/avatars/mario-sm.webp" alt="Mario Kuren" width="56" height="56" loading="lazy" decoding="async" />
          </div>
          </a>
          <div>
            <a href="/author/mario-kuren/" class="author-bio__name" itemprop="name">Mario Kuren</a>
            <p class="author-bio__role">CRO Specialist & Founder</p>
            <p class="author-bio__bio">
              Mario has been running A/B tests and conversion optimization programs since 2018.
              He's helped 50+ businesses grow revenue without increasing ad spend.
              <a href="/author/mario-kuren/">Read all his articles →</a>
            </p>
          </div>
        </div>

        <!-- CTA block -->
        <div class="blog-post__cta-block">
          <p class="blog-post__cta-eyebrow">Want us to apply this to your site?</p>
          <h2 class="blog-post__cta-title">Get a Free CRO Audit</h2>
          <p class="blog-post__cta-body">
            We'll analyze your site, find the biggest conversion leaks, and hand you a
            prioritized action plan — completely free.
          </p>
          <a href="/contact/" class="btn btn--primary">
            Book Your Free Audit
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Related posts -->
        {relatedPosts.length > 0 && (
          <section class="related-posts" aria-labelledby="related-heading">
            <h2 class="related-posts__title" id="related-heading">Keep Reading</h2>
            <div class="related-posts__grid">
              {relatedPosts.map((rp) => (
                <a href={`/blog/${rp.slug}/`} class="related-card">
                  <span class="related-card__category">{rp.data.category}</span>
                  <h3 class="related-card__title">{rp.data.title}</h3>
                  <p class="related-card__desc">{rp.data.description}</p>
                  <span class="related-card__cta">
                    Read article
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0; left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent), #22C55E);
    z-index: 200;
    pointer-events: none;
    transition: width 80ms linear;
  }

  /* Header */
  .blog-post__header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .blog-post__hero {
   padding-top:20px;
  }

  .blog-post__hero-img {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin: 0 auto;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .blog-post__header-inner { max-width: 780px; }

  .blog-post__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .blog-post__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .blog-post__author-link { text-decoration: none; }

  .blog-post__author-avatar {
    width: 44px; height: 44px;
    border-radius: var(--radius-full);
    overflow: hidden;
    flex-shrink: 0;
    transition: box-shadow var(--transition-fast);
  }

  .blog-post__author-avatar img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-post__author-link:hover .blog-post__author-avatar {
    box-shadow: 0 0 0 3px var(--color-accent-light);
  }

  .blog-post__author-name {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-heading);
    text-decoration: none;
    display: block;
    transition: color var(--transition-fast);
  }

  .blog-post__author-name:hover { color: var(--color-accent); }

  .blog-post__meta-details {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  /* Two-column layout */
  .blog-post__layout {
    display: grid;
    grid-template-columns: var(--toc-width, 260px) 1fr;
    gap: var(--space-16);
    align-items: start;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  /* TOC + sidebar */
  .blog-post__toc {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .toc {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .toc__title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  :global(#toc-nav a) {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-1) 0;
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3));
    transition: color var(--transition-fast), border-color var(--transition-fast);
    text-decoration: none;
    line-height: 1.4;
  }

  :global(#toc-nav a:hover),
  :global(#toc-nav a.is-active) {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  :global(#toc-nav .toc-h3) {
    padding-left: calc(var(--space-3) * 2);
    margin-left: calc(-1 * var(--space-3));
    font-size: var(--text-xs);
  }

  /* Sidebar CTA */
  .sidebar-cta {
    background: linear-gradient(135deg, var(--color-accent-light), rgba(235,247,238,0.3));
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .sidebar-cta__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .sidebar-cta__title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .sidebar-cta__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: var(--space-4);
  }

  .sidebar-cta__btn {
    width: 100%;
    justify-content: center;
    font-size: var(--text-sm);
    padding: 0.625rem 1rem;
  }

  .sidebar-cta__note {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-align: center;
    margin-top: var(--space-2);
  }

  /* Tags */
  /* FAQ section */
  .post-faq {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .post-faq h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .post-faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .post-faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .post-faq__item[open] {
    border-color: var(--color-border-accent);
  }

  .post-faq__q {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-heading);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    background: var(--color-surface);
    transition: background var(--transition-fast);
  }

  .post-faq__q::-webkit-details-marker { display: none; }

  .post-faq__q::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .post-faq__item[open] .post-faq__q::after {
    transform: rotate(45deg);
  }

  .post-faq__q:hover { background: var(--color-accent-subtle); }

  .post-faq__a {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    padding: var(--space-4) var(--space-5);
    margin: 0;
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .blog-post__tags-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  /* Prev / Next */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .post-nav__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .post-nav__item:hover {
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-accent);
  }

  .post-nav__item--next { text-align: right; }

  .post-nav__label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .post-nav__item--next .post-nav__label { justify-content: flex-end; }

  .post-nav__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-heading);
    line-height: 1.35;
  }

  /* Author bio */
  .author-bio {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-10);
  }

  .author-bio__avatar-link { text-decoration: none; flex-shrink: 0; }

  .author-bio__avatar {
    width: 56px; height: 56px;
    border-radius: var(--radius-full);
    overflow: hidden;
    transition: box-shadow var(--transition-fast);
  }

  .author-bio__avatar img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  .author-bio__avatar-link:hover .author-bio__avatar {
    box-shadow: 0 0 0 3px var(--color-accent-light);
  }

