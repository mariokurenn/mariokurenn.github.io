    gap: 6px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    transition: background 0.15s, transform 0.15s;
  }

  .mobile-toc__trigger:hover { background: var(--color-accent); transform: translateY(-1px); }

  .mobile-toc {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 150;
  }

  .mobile-toc[aria-hidden="false"] { display: block; }

  .mobile-toc__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
  }

  .mobile-toc__drawer {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: #fff;
    border-radius: 20px 20px 0 0;
    max-height: 70vh;
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom, 16px);
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.32,0.72,0,1);
  }

  .mobile-toc[aria-hidden="false"] .mobile-toc__drawer {
    transform: translateY(0);
  }

  .mobile-toc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px 12px;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: #fff;
    z-index: 1;
  }

  .mobile-toc__title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .mobile-toc__close {
    background: none;
    border: none;
    font-size: 1rem;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
  }

  .mobile-toc__close:hover { background: var(--color-surface); }

  :global(#mobile-toc-nav a) {
    display: block;
    padding: 12px 20px;
    font-size: 0.9375rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.1s, color 0.1s;
  }

  :global(#mobile-toc-nav .toc-h3) {
    padding-left: 36px;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  :global(#mobile-toc-nav a:hover),
  :global(#mobile-toc-nav a.is-active) {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .mobile-toc__trigger { display: inline-flex; }
  }
</style>

<script>
  // Reading progress bar
  const bar = document.getElementById('reading-progress') as HTMLElement | null;
  const article = document.querySelector('.blog-post__body') as HTMLElement | null;

  if (bar && article) {
    window.addEventListener('scroll', () => {
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const pct = Math.min(100, (scrolled / total) * 100);
      bar.style.width = `${pct}%`;
    }, { passive: true });
  }

  // Build TOC from headings
  const tocNav = document.getElementById('toc-nav');
  const headings = document.querySelectorAll<HTMLElement>('.prose h2, .prose h3');

  if (tocNav && headings.length > 0) {
    headings.forEach((heading) => {
      if (!heading.id) return;
      const level = heading.tagName === 'H2' ? 'h2' : 'h3';
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent ?? '';
      link.className = `toc-${level}`;
      tocNav.appendChild(link);
    });

    // Scroll spy
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute('id');
          const link = tocNav.querySelector<HTMLAnchorElement>(`a[href="#${id}"]`);
          if (link) link.classList.toggle('is-active', entry.isIntersecting);
        });
      },
      { rootMargin: '-20% 0% -70% 0%' }
    );

    headings.forEach((h) => observer.observe(h));
  }

  // Mobile TOC
  const mobileToc = document.getElementById('mobile-toc') as HTMLElement | null;
  const mobileTocNav = document.getElementById('mobile-toc-nav') as HTMLElement | null;
  const mobileTocTrigger = document.getElementById('mobile-toc-trigger') as HTMLButtonElement | null;
  const mobileTocClose = document.getElementById('mobile-toc-close') as HTMLButtonElement | null;
  const mobileTocBackdrop = document.getElementById('mobile-toc-backdrop') as HTMLElement | null;

  if (mobileToc && mobileTocNav && tocNav) {
    // Clone links from desktop TOC into mobile TOC
    mobileTocNav.innerHTML = tocNav.innerHTML;

    const openToc = () => {
      mobileToc.setAttribute('aria-hidden', 'false');
      mobileTocTrigger?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const closeToc = () => {
      mobileToc.setAttribute('aria-hidden', 'true');
      mobileTocTrigger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    mobileTocTrigger?.addEventListener('click', openToc);
    mobileTocClose?.addEventListener('click', closeToc);
    mobileTocBackdrop?.addEventListener('click', closeToc);

    // Close on link click
    mobileTocNav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', closeToc);
    });
  }
</script>
