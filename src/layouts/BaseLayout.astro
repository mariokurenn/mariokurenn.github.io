---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/layout/SEO.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/components.css';
import '../styles/pages.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const seoProps = Astro.props;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'grow-conversions.com',
  url: 'https://grow-conversions.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://grow-conversions.com/blog/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://grow-conversions.com/#organization',
  name: 'grow-conversions.com',
  url: 'https://grow-conversions.com',
  description: "Data-driven conversion rate optimization agency. We grow businesses by fixing what's leaking in their funnel.",
  areaServed: 'Worldwide',
  founder: {
    '@type': 'Person',
    name: 'Mario Kuren',
    url: 'https://grow-conversions.com/author/mario-kuren/',
    jobTitle: 'CRO Specialist & Founder',
  },
  logo: {
    '@type': 'ImageObject',
    url: 'https://grow-conversions.com/favicon.svg',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    url: 'https://grow-conversions.com/contact/',
    contactType: 'customer service',
    availableLanguage: ['English'],
  },
};

const resolvedJsonLd = seoProps.jsonLd
  ? (Array.isArray(seoProps.jsonLd) ? [websiteSchema, organizationSchema, ...seoProps.jsonLd] : [websiteSchema, organizationSchema, seoProps.jsonLd])
  : [websiteSchema, organizationSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1A7F3C" />
    <meta name="author" content="Mario Kuren" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <SEO {...seoProps} jsonLd={resolvedJsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>

