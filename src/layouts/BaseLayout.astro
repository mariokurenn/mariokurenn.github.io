---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/layout/SEO.astro';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/components.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const seoProps = Astro.props;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'grow-conversions.com',
  url: 'https://grow-conversions.com',
};

const resolvedJsonLd = seoProps.jsonLd
  ? (Array.isArray(seoProps.jsonLd) ? [websiteSchema, ...seoProps.jsonLd] : [websiteSchema, seoProps.jsonLd])
  : [websiteSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1A7F3C" />
    <meta name="author" content="Mario Kuren" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <SEO {...seoProps} jsonLd={resolvedJsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

