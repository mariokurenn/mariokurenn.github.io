---
/**
 * Generic page layout for interior pages (About, Contact, Services, etc.)
 * Provides consistent page header + breadcrumb structure.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  headline?: string;
  subheadline?: string;
  breadcrumbs?: Array<{ href?: string; label: string }>;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  headline,
  subheadline,
  breadcrumbs = [],
  ogImage,
  jsonLd,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  {(headline || breadcrumbs.length > 0) && (
    <div class="page-header">
      <div class="container">
        {breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            {breadcrumbs.map(({ href, label }, i) => (
              <>
                {i > 0 && <span class="breadcrumbs__separator" aria-hidden="true">/</span>}
                {href
                  ? <a href={href}>{label}</a>
                  : <span class="breadcrumbs__current" aria-current="page">{label}</span>
                }
              </>
            ))}
          </nav>
        )}
        {headline && <h1 class="page-header__title">{headline}</h1>}
        {subheadline && <p class="page-header__subtitle">{subheadline}</p>}
      </div>
    </div>
  )}
  <slot />
</BaseLayout>

<style>
  .page-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0;
  }

  .page-header__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: var(--space-4) 0;
    max-width: 800px;
  }

  .page-header__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    line-height: 1.6;
  }
</style>
