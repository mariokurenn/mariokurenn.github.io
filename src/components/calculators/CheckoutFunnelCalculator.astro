---
// Checkout Funnel Drop-off Calculator
---

<div class="calc-highlight">
  <span class="calc-highlight-badge">Free Tool</span>
  <span class="calc-highlight-text">See exactly where your checkout is leaking revenue</span>
</div>
<div class="calc-wrap calc-wrap--featured" id="checkout-funnel-calculator">
  <div class="calc-header">
    <div class="calc-icon">⬇</div>
    <div>
      <h3 class="calc-title">Checkout Funnel Drop-off Calculator</h3>
      <p class="calc-subtitle">Enter visitors at each step to pinpoint where you're losing the most shoppers — and how much it's costing you</p>
    </div>
  </div>

  <div class="calc-body">
    <div class="calc-inputs">
      <div class="calc-funnel-steps" id="funnel-step-inputs">
        <div class="calc-funnel-step-inputs">
          <div class="calc-field"><label for="f-step-0">Product Page Visitors</label><input type="number" id="f-step-0" placeholder="e.g. 10000" min="0" /></div>
          <div class="calc-field"><label for="f-aov">Avg Order Value (€)</label><input type="number" id="f-aov" placeholder="e.g. 85" min="1" /></div>
        </div>
        <div class="calc-funnel-step-inputs">
          <div class="calc-field"><label for="f-step-1">Added to Cart</label><input type="number" id="f-step-1" placeholder="e.g. 1800" min="0" /></div>
          <div></div>
        </div>
        <div class="calc-funnel-step-inputs">
          <div class="calc-field"><label for="f-step-2">Reached Checkout</label><input type="number" id="f-step-2" placeholder="e.g. 900" min="0" /></div>
          <div></div>
        </div>
        <div class="calc-funnel-step-inputs">
          <div class="calc-field"><label for="f-step-3">Entered Payment</label><input type="number" id="f-step-3" placeholder="e.g. 540" min="0" /></div>
          <div></div>
        </div>
        <div class="calc-funnel-step-inputs">
          <div class="calc-field"><label for="f-step-4">Completed Purchase</label><input type="number" id="f-step-4" placeholder="e.g. 320" min="0" /></div>
          <div></div>
        </div>
      </div>
    </div>

    <div class="calc-results" id="funnel-results" style="display:none">
      <div class="calc-result-primary">
        <span class="calc-result-label">Revenue Lost to Drop-off</span>
        <span class="calc-result-value" id="funnel-lost-revenue">—</span>
      </div>

      <div class="calc-funnel-results">
        <div class="calc-funnel-row calc-funnel-row--header">
          <span>Step</span>
          <span>Visitors</span>
          <span>CVR from Top</span>
          <span>Drop-off</span>
        </div>
        <div id="funnel-rows"></div>
      </div>

      <div class="calc-result-grid" style="margin-top:var(--space-4)">
        <div class="calc-result-card">
          <span class="calc-result-card-label">End-to-End CVR</span>
          <span class="calc-result-card-value" id="funnel-e2e-cvr">—</span>
        </div>
        <div class="calc-result-card calc-result-card--green">
          <span class="calc-result-card-label">Biggest Leak</span>
          <span class="calc-result-card-value" id="funnel-biggest-leak">—</span>
        </div>
        <div class="calc-result-card">
          <span class="calc-result-card-label">Monthly Revenue</span>
          <span class="calc-result-card-value" id="funnel-revenue">—</span>
        </div>
        <div class="calc-result-card calc-result-card--green">
          <span class="calc-result-card-label">+10% Fix = Extra</span>
          <span class="calc-result-card-value" id="funnel-10pct">—</span>
        </div>
      </div>
      <p class="calc-note" id="funnel-note"></p>
    </div>
  </div>
</div>

<script>
  const stepLabels = ['Product Page', 'Add to Cart', 'Checkout Start', 'Payment Step', 'Purchase'];

  function calcFunnel() {
    const steps = [0,1,2,3,4].map(i => parseFloat((document.getElementById(`f-step-${i}`) as HTMLInputElement).value) || 0);
    const aov = parseFloat((document.getElementById('f-aov') as HTMLInputElement).value) || 0;

    if (!steps[0] || !aov) return;

    const top = steps[0];
    const completions = steps[4];

    // Calculate drop rates between consecutive steps
    const dropRates: number[] = [];
    for (let i = 1; i < steps.length; i++) {
      const prev = steps[i-1];
      const curr = steps[i];
      dropRates.push(prev > 0 && curr > 0 ? (prev - curr) / prev * 100 : 0);
    }

    // Find biggest leak (highest absolute drop in visitors)
    let biggestLeakIdx = 0;
    let biggestLeakAbs = 0;
    for (let i = 1; i < steps.length; i++) {
      const dropped = steps[i-1] - steps[i];
      if (dropped > biggestLeakAbs && steps[i-1] > 0 && steps[i] > 0) {
        biggestLeakAbs = dropped;
        biggestLeakIdx = i;
      }
    }

    // Revenue
    const currentRevenue = completions * aov;
    const potentialRevenue = top * aov; // if everyone converted
    const lostRevenue = potentialRevenue - currentRevenue;
    const e2eCvr = top > 0 ? (completions / top) * 100 : 0;

    // Fix at biggest leak: +10% recovery
    const leakPrev = steps[biggestLeakIdx - 1];
    const leakCurr = steps[biggestLeakIdx];
    const recovered = (leakPrev - leakCurr) * 0.10;
    const extraRevenue = recovered * aov * (completions / (leakCurr || 1)); // roughly

    // Render funnel rows
    const rowsEl = document.getElementById('funnel-rows') as HTMLElement;
    rowsEl.innerHTML = '';
    steps.forEach((visitors, i) => {
      if (!visitors) return;
      const cvrFromTop = top > 0 ? (visitors / top * 100) : 0;
      const drop = i > 0 && steps[i-1] > 0 ? dropRates[i-1] : null;
      const isLeak = i === biggestLeakIdx && biggestLeakAbs > 0;

      const row = document.createElement('div');
      row.className = 'calc-funnel-row' + (isLeak ? ' calc-funnel-row--leak' : '');

      const barPct = Math.max(cvrFromTop, 0);
      const dropColor = drop !== null ? (drop > 40 ? 'calc-funnel-drop' : 'calc-funnel-drop--ok') : '';
      row.innerHTML = `
        <span style="font-weight:${isLeak?'700':'500'}">${stepLabels[i]}${isLeak ? ' 🔴' : ''}</span>
        <div>
          <div class="calc-funnel-bar-wrap">
            <div class="calc-funnel-bar ${isLeak?'calc-funnel-bar--leak':''}" style="width:${barPct}%"></div>
          </div>
          <span style="font-size:0.72rem;color:var(--color-text-muted)">${visitors.toLocaleString()} visitors</span>
        </div>
        <span class="calc-funnel-stat">${cvrFromTop.toFixed(1)}%</span>
        <span class="${dropColor}">${drop !== null ? '-' + drop.toFixed(0) + '%' : '—'}</span>
      `;
      rowsEl.appendChild(row);
    });

    document.getElementById('funnel-lost-revenue')!.textContent = '€' + Math.round(lostRevenue).toLocaleString() + ' lost/mo';
    document.getElementById('funnel-e2e-cvr')!.textContent = e2eCvr.toFixed(2) + '%';
    document.getElementById('funnel-revenue')!.textContent = '€' + Math.round(currentRevenue).toLocaleString();
    document.getElementById('funnel-biggest-leak')!.textContent = biggestLeakIdx > 0 ? `${stepLabels[biggestLeakIdx-1]}→${stepLabels[biggestLeakIdx]}` : '—';
    document.getElementById('funnel-10pct')!.textContent = '+€' + Math.round(extraRevenue).toLocaleString() + '/mo';

    document.getElementById('funnel-note')!.textContent = `Fixing the biggest drop-off point (${biggestLeakIdx > 0 ? stepLabels[biggestLeakIdx-1] + ' → ' + stepLabels[biggestLeakIdx] : 'n/a'}) by just 10% would recover approximately €${Math.round(extraRevenue).toLocaleString()}/month from your current traffic.`;

    document.getElementById('funnel-results')!.style.display = 'block';
  }

  ['f-step-0','f-step-1','f-step-2','f-step-3','f-step-4','f-aov'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calcFunnel);
  });
</script>
