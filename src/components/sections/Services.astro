---
const services = [
  {
    href: '/services/cro-audit/',
    title: 'CRO Audit',
    description: "A comprehensive 47-point audit of your funnel, landing pages, and user flows. We find what's killing your conversions and hand you a prioritised action plan.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 11l3 3L22 4"/>
      <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
    </svg>`,
    highlights: ['Heuristic evaluation', 'Analytics deep-dive', 'User flow analysis', 'Prioritised fix list'],
    metric: '47',
    metricSuffix: '-point',
    metricLabel: 'audit framework',
    result: 'Avg. 23 critical issues found',
    badge: 'Most popular',
  },
  {
    href: '/services/ab-testing/',
    title: 'A/B Testing',
    description: "We design, run, and analyse statistically significant split tests that prove what works. No guessing — only data-backed decisions that compound over time.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/>
      <path d="M13 13l6 6"/>
    </svg>`,
    highlights: ['Hypothesis-driven', 'Statistical significance', 'Full-funnel tests', 'Ongoing iteration'],
    metric: '800',
    metricSuffix: '+',
    metricLabel: 'tests run to date',
    result: 'Avg. +34% per winning test',
    badge: null,
  },
  {
    href: '/services/landing-page-design/',
    title: 'Landing Page Design',
    description: "High-converting landing pages built from the ground up — designed around your audience's psychology, not just aesthetics. Every element earns its place.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="2"/>
      <path d="M3 9h18M9 21V9"/>
    </svg>`,
    highlights: ['Psychology-first copy', 'Mobile-optimised', 'Speed-focused build', 'Iterative testing'],
    metric: '3.8',
    metricSuffix: '×',
    metricLabel: 'avg. return on ad spend (ROAS)',
    result: 'Avg. +92% page conversions',
    badge: null,
  },
  {
    href: '/services/conversion-copywriting/',
    title: 'Conversion Copywriting',
    description: "Words that sell. We write headlines, CTAs, email sequences, and product copy that speak directly to your buyer's pains and move them to act.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 20h9"/>
      <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
    </svg>`,
    highlights: ['Voice-of-customer research', 'Headline testing', 'Email sequences', 'Product copy'],
    metric: '2.4',
    metricSuffix: '×',
    metricLabel: 'avg. copy lift',
    result: 'Avg. +67% email click-through',
    badge: null,
  },
];
---

<section class="services section" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="section-label">What We Do</span>
        <h2 class="section-title" id="services-heading">
          CRO Services That Move<br />the Revenue Needle
        </h2>
      </div>
      <p class="section-subtitle" style="margin-top: var(--space-4);">
        Every engagement is focused on one thing: turning more of your existing traffic into customers — without spending more on ads.
      </p>
    </div>

    <div class="services__grid">
      {services.map(({ href, title, description, icon, highlights, metric, metricSuffix, metricLabel, result, badge }) => (
        <a href={href} class="svc-card" aria-label={`Learn more about ${title}`}>
          {badge && (
            <span class="svc-card__badge">{badge}</span>
          )}

          <div class="svc-card__top">
            <div class="svc-card__icon" aria-hidden="true" set:html={icon} />
            <div class="svc-card__metric" aria-label={`${metric}${metricSuffix} ${metricLabel}`}>
              <span class="svc-card__metric-num">{metric}<span class="svc-card__metric-suf">{metricSuffix}</span></span>
              <span class="svc-card__metric-lbl">{metricLabel}</span>
            </div>
          </div>

          <h3 class="svc-card__title">{title}</h3>
          <p class="svc-card__desc">{description}</p>

          <ul class="svc-card__list" aria-label={`${title} highlights`}>
            {highlights.map((item) => (
              <li>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <div class="svc-card__result">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" aria-hidden="true">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
            </svg>
            {result}
          </div>

          <span class="svc-card__cta">
            Learn more
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <p class="services__disclaimer">
      Average results across 50+ client engagements. Individual results vary based on site, traffic, and implementation.
    </p>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-12);
    margin-bottom: var(--space-5);
  }

  /* Card */
  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--transition-base),
      transform var(--transition-base),
      border-color var(--transition-base);
    overflow: hidden;
  }

  .svc-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1);
    border-radius: var(--radius-full) var(--radius-full) 0 0;
  }

  .svc-card:hover {
    box-shadow: var(--shadow-accent);
    transform: translateY(-3px);
    border-color: var(--color-border-accent);
  }

  .svc-card:hover::after { transform: scaleX(1); }

  /* "Most popular" badge */
  .svc-card__badge {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    background: var(--color-accent);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
  }

  /* Top row: icon + metric */
  .svc-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .svc-card__icon {
    width: 48px; height: 48px;
    background: var(--color-accent-light);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Outcome metric */
  .svc-card__metric {
    text-align: right;
  }

  .svc-card__metric-num {
    display: block;
    font-size: var(--text-2xl);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--color-heading);
    line-height: 1;
  }

  .svc-card__metric-suf {
    font-size: 0.65em;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .svc-card__metric-lbl {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    font-weight: 500;
    margin-top: 2px;
  }

  /* Content */
  .svc-card__title {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-heading);
    margin-bottom: var(--space-3);
  }

  .svc-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-5);
    flex: 1;
  }

  /* Feature list */
  .svc-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .svc-card__list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Result callout */
  .svc-card__result {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-light);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-6);
    width: fit-content;
  }

  /* CTA link */
  .svc-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    margin-top: auto;
    transition: gap var(--transition-fast);
  }

  .svc-card:hover .svc-card__cta { gap: var(--space-3); }

  /* Disclaimer */
  .services__disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-align: center;
    margin-top: var(--space-4);
  }

  @media (max-width: 768px) {
    .services__grid { grid-template-columns: 1fr; }
  }
</style>
