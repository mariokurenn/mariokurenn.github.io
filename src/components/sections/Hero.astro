---
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">

    <!-- Badge -->
    <a href="/services/cro-audit/" class="hero__badge">
      What's in the free 47-point audit
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

    <!-- H1 -->
    <h1 class="hero__h1" id="hero-heading">
      97% of Your Visitors<br />
      Leave Without <span class="hero__h1-accent">Converting.</span>
    </h1>

    <!-- Subheadline -->
    <p class="hero__sub">
      Data-driven conversion rate optimisation (CRO) that finds exactly what's costing
      you sales — then systematically fixes it. Clients average a
      <strong>127% lift in conversion rate</strong> within 90 days, at
      <strong>4.8× return on investment</strong>.
    </p>

    <!-- CTAs -->
    <div class="hero__actions">
      <a href="/contact/" class="hero__btn-primary">
        Book Your Free Audit
      </a>
      <a href="#results" class="hero__btn-ghost">
        See Client Results
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Social proof -->
    <div class="hero__social-proof">
      <div class="hero__avatars" aria-hidden="true">
        {[
          '/images/avatars/reviewer-1.webp',
          '/images/avatars/reviewer-2.webp',
          '/images/avatars/reviewer-3.webp',
          '/images/avatars/reviewer-4.webp',
          '/images/avatars/reviewer-5.webp',
        ].map((src) => (
          <img src={src} alt="" class="hero__av" width="30" height="30" loading="eager" decoding="async" fetchpriority="low" />
        ))}
      </div>
      <div class="hero__sp-text">
        <div class="hero__stars" aria-label="Rated 4.9 out of 5">
          {Array.from({length:5}).map(() => (
            <svg width="13" height="13" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ))}
        </div>
        <span><strong>4.9/5</strong> · 47 reviews · 50+ businesses optimised</span>
      </div>
    </div>

  </div>

  <!-- Logo strip -->
  <div class="hero__logos">
    <div class="container">
      <p class="hero__logos-lbl">Proven with e-commerce, SaaS, and lead-gen businesses</p>
      <div class="hero__logos-row">
        {[
          { src: '/images/logos/eljekarna24.svg', alt: 'eLjekarna 24 logo' },
          { src: '/images/logos/client-1.png', alt: 'Client 1 logo' },
          { src: '/images/logos/client-2.svg', alt: 'Client 2 logo' },
          { src: '/images/logos/client-3.png', alt: 'Client 3 logo' },
          { src: '/images/logos/client-4.png', alt: 'Client 4 logo' },
          { src: '/images/logos/client-5.webp', alt: 'Client 5 logo' },
          { src: '/images/logos/client-6.png', alt: 'Client 6 logo' },
        ].map(({ src, alt }) => (
          <div class="hero__logo">
            <img src={src} alt={alt} loading="eager" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  background: var(--gradient-hero);
  overflow: hidden;
}

.hero__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-block: clamp(var(--space-14), 8vw, var(--space-20));
  max-width: 800px;
}

/* Badge */
.hero__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-accent-light);
  border: 1px solid rgba(26,127,60,0.2);
  color: var(--color-accent);
  font-size: var(--text-xs);
  font-weight: 700;
  padding: 0.35rem 0.875rem;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-6);
  text-decoration: none;
  transition: background var(--transition-fast), box-shadow var(--transition-fast);
}

.hero__badge:hover {
  background: rgba(26,127,60,0.12);
  box-shadow: 0 0 0 3px rgba(26,127,60,0.1);
}

.hero__badge svg { flex-shrink: 0; transition: transform var(--transition-fast); }
.hero__badge:hover svg { transform: translateX(3px); }

/* H1 */
.hero__h1 {
  font-size: clamp(2.5rem, 4.5vw, 4rem);
  font-weight: 900;
  line-height: 1.0;
  letter-spacing: -0.05em;
  text-wrap: balance;
  color: var(--color-heading);
  margin-bottom: var(--space-6);
}

.hero__h1-accent {
  color: var(--color-accent);
  position: relative;
  display: inline-block;
}

.hero__h1-accent::after {
  content: '';
  position: absolute;
  inset-inline: 0;
  bottom: 2px;
  height: 5px;
  background: var(--color-accent);
  border-radius: 3px;
  opacity: 0.18;
  transform: scaleX(0);
  transform-origin: left;
  animation: underline-in 0.7s cubic-bezier(0.16,1,0.3,1) 0.3s forwards;
}

@keyframes underline-in { to { transform: scaleX(1); } }

/* Sub */
.hero__sub {
  font-size: clamp(var(--text-base), 1.5vw, var(--text-lg));
  color: var(--color-text-muted);
  line-height: 1.7;
  max-width: 580px;
  margin-bottom: var(--space-8);
}

/* CTAs */
.hero__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-bottom: var(--space-8);
}

.hero__btn-primary {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-base);
  font-weight: 700;
  padding: 0.9375rem 1.875rem;
  border-radius: var(--radius-md);
  border: 2px solid var(--color-accent);
  text-decoration: none;
  letter-spacing: -0.01em;
  box-shadow:
    0 4px 0 0 var(--color-accent-hover),
    0 8px 24px rgba(26,127,60,.22);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.hero__btn-primary:hover {
  transform: translateY(-2px);
  box-shadow:
    0 6px 0 0 var(--color-accent-hover),
    0 14px 32px rgba(26,127,60,.28);
}

.hero__btn-primary:active {
  transform: translateY(3px);
  box-shadow: 0 1px 0 0 var(--color-accent-hover);
}

.hero__btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text-muted);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color var(--transition-fast), border-color var(--transition-fast);
  padding-block-end: 1px;
}

.hero__btn-ghost svg { transition: transform var(--transition-fast); }
.hero__btn-ghost:hover { color: var(--color-accent); border-color: var(--color-accent); }
.hero__btn-ghost:hover svg { transform: translateX(4px); }

/* Social proof */
.hero__social-proof {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.hero__avatars { display: flex; }

.hero__av {
  width: 30px; height: 30px;
  border-radius: 50%;
  border: 2px solid #fff;
  margin-inline-start: -7px;
  flex-shrink: 0;
  box-shadow: 0 1px 4px rgba(0,0,0,.12);
  object-fit: cover;
  display: block;
}

.hero__avatars .hero__av:first-child { margin-inline-start: 0; }

.hero__sp-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hero__stars { display: flex; gap: 2px; }

.hero__sp-text span {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  font-weight: 500;
}

.hero__sp-text strong { color: var(--color-heading); }

/* Logo strip */
.hero__logos {
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  padding: var(--space-7) 0;
}

.hero__logos-lbl {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
  text-align: center;
  margin-bottom: var(--space-5);
}

.hero__logos-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  flex-wrap: wrap;
}

.hero__logo img {
  height: 36px;
  width: auto;
  max-width: 140px;
  object-fit: contain;
  display: block;
  filter: brightness(0);
  opacity: 0.55;
  transition: opacity var(--transition-fast);
}

.hero__logo img:hover {
  opacity: 0.9;
}

/* Stacked lockup — needs extra height to read at the same optical size */
.hero__logo img[src$="eljekarna24.svg"] { height: 48px; }

/* Responsive */
@media (max-width: 640px) {
  .hero__h1 { font-size: clamp(2.5rem, 11vw, 3.5rem); }
  .hero__logos-row { gap: var(--space-4); }
  .hero__logo img { height: 22px; max-width: 80px; }
  .hero__logo img[src$="eljekarna24.svg"] { height: 30px; }
}

@media (max-width: 380px) {
  .hero__h1 { font-size: 2.25rem; }
}

@media (prefers-reduced-motion: reduce) {
  .hcard__bar-fill,
  .hero__h1-accent::after {
    animation: none !important;
    opacity: 1 !important;
    width: var(--w, auto) !important;
    transform: none !important;
  }
}
</style>
