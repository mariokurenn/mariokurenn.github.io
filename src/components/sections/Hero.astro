---
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__grid">

    <!-- ══════════════════════════════════
         COPY — LEFT
    ══════════════════════════════════ -->
    <div class="hero__copy">

      <a href="/services/cro-audit/" class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        New: Free 47-point CRO Audit — limited spots
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>

      <h1 class="hero__h1" id="hero-heading">
        Your Traffic<br />
        Deserves to<br />
        <span class="hero__h1-accent">Convert.</span>
      </h1>

      <p class="hero__sub">
        We find what's blocking your conversions, build the experiments,
        and grow your revenue — without increasing your ad spend.
      </p>

      <div class="hero__actions">
        <a href="/contact/" class="hero__btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          Book Your Free Audit
        </a>
        <a href="#results" class="hero__btn-ghost">
          See client results
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <ul class="hero__guarantees" aria-label="Guarantees">
        {[
          'Free audit, no commitment',
          'First results within 30 days',
          'No long-term contracts',
        ].map((g) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {g}
          </li>
        ))}
      </ul>

      <div class="hero__social-proof">
        <div class="hero__avatars" aria-hidden="true">
          {['#1A7F3C','#2563EB','#7C3AED','#D97706','#DB2777'].map((c) => (
            <span class="hero__av" style={`background:${c}`}></span>
          ))}
        </div>
        <div class="hero__sp-text">
          <div class="hero__stars" aria-label="Rated 4.9 out of 5">
            {Array.from({length:5}).map(() => (
              <svg width="13" height="13" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <span><strong>4.9/5</strong> · 47 reviews · 50+ businesses optimized</span>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════
         VISUAL PANEL — RIGHT
    ══════════════════════════════════ -->
    <div class="hero__panel" aria-hidden="true">

      <!-- ── Card 1: Main CVR lift ── -->
      <div class="hcard hcard--main">
        <div class="hcard__topbar">
          <span class="hcard__live">
            <span class="hcard__live-dot"></span>Live result
          </span>
          <span class="hcard__win">+128% CVR ↑</span>
        </div>

        <p class="hcard__eyebrow">Conversion Rate — 90-day programme</p>

        <div class="hcard__bigs">
          <div class="hcard__big hcard__big--before">
            <span class="hcard__big-num">2.1%</span>
            <span class="hcard__big-lbl">Before</span>
          </div>
          <div class="hcard__chevron">
            <svg width="36" height="36" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="18" fill="var(--color-accent-light)"/>
              <path d="M13 18h10M20 14l4 4-4 4" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="hcard__big hcard__big--after">
            <span class="hcard__big-num">4.8%</span>
            <span class="hcard__big-lbl">After</span>
          </div>
        </div>

        <!-- Bars -->
        <div class="hcard__bars">
          <div class="hcard__bar-row">
            <span class="hcard__bar-lbl">Before</span>
            <div class="hcard__bar-track">
              <div class="hcard__bar-fill hcard__bar-fill--b" style="--w:28%"></div>
            </div>
            <span class="hcard__bar-val">2.1%</span>
          </div>
          <div class="hcard__bar-row">
            <span class="hcard__bar-lbl">After</span>
            <div class="hcard__bar-track">
              <div class="hcard__bar-fill hcard__bar-fill--a" style="--w:64%"></div>
            </div>
            <span class="hcard__bar-val hcard__bar-val--g">4.8%</span>
          </div>
        </div>

        <div class="hcard__foot">E-commerce · Apparel · United Kingdom</div>
      </div>

      <!-- ── Row: 2 smaller cards ── -->
      <div class="hcard-row">

        <!-- Card 2: A/B test -->
        <div class="hcard hcard--sm hcard--test">
          <div class="hcard-sm__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/><path d="M13 13l6 6"/></svg>
          </div>
          <div class="hcard-sm__body">
            <p class="hcard-sm__title">A/B Test Complete</p>
            <p class="hcard-sm__sub">Headline B — stat. significant</p>
            <div class="hcard-sm__pill hcard-sm__pill--green">+34% clicks</div>
          </div>
        </div>

        <!-- Card 3: Revenue -->
        <div class="hcard hcard--sm hcard--rev">
          <div class="hcard-sm__icon hcard-sm__icon--blue">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <div class="hcard-sm__body">
            <p class="hcard-sm__title">Revenue Added</p>
            <p class="hcard-sm__sub">vs. same period last month</p>
            <p class="hcard-sm__big">+$182K</p>
          </div>
        </div>

      </div>

      <!-- ── Stats strip ── -->
      <div class="hcard hcard--stats">
        {[
          { n:'127', s:'%', l:'Avg. CVR increase' },
          { n:'800', s:'+', l:'A/B tests run' },
          { n:'4.8', s:'×', l:'Avg. ROI delivered' },
        ].map(({ n, s, l }) => (
          <div class="hstat">
            <span class="hstat__num" data-count={n} data-suffix={s}>0{s}</span>
            <span class="hstat__lbl">{l}</span>
          </div>
        ))}
      </div>

    </div><!-- /hero__panel -->
  </div>

  <!-- Logo strip -->
  <div class="hero__logos">
    <div class="container">
      <p class="hero__logos-lbl">Proven with e-commerce, SaaS, and lead-gen businesses</p>
      <div class="hero__logos-row">
        {Array.from({length:6}).map(() => (
          <div class="hero__logo">
            <svg viewBox="0 0 100 24" fill="none">
              <rect width="100" height="24" rx="4" fill="var(--color-border)"/>
            </svg>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ══════════════════════════════════════════════
   SECTION SHELL
══════════════════════════════════════════════ */

.hero {
  background: #fff;
  /* subtle dot grid */
  background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
  background-size: 28px 28px;
  padding-block-start: var(--space-16);
  overflow: hidden;
}

/* ══════════════════════════════════════════════
   TWO-COLUMN GRID
══════════════════════════════════════════════ */

.hero__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(var(--space-10), 5vw, var(--space-20));
  align-items: center;
  padding-block-end: var(--space-20);
  /* tall enough to breathe */
  min-height: max(580px, calc(100svh - 68px - 112px));
}

/* ══════════════════════════════════════════════
   COPY — LEFT
══════════════════════════════════════════════ */

/* Badge */
.hero__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-accent-light);
  border: 1px solid rgba(26,127,60,0.2);
  color: var(--color-accent);
  font-size: var(--text-xs);
  font-weight: 700;
  padding: 0.35rem 0.875rem;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-6);
  text-decoration: none;
  transition: background var(--transition-fast), box-shadow var(--transition-fast);
  width: fit-content;
}

.hero__badge:hover {
  background: rgba(26,127,60,0.12);
  box-shadow: 0 0 0 3px rgba(26,127,60,0.1);
}

.hero__badge svg { flex-shrink: 0; transition: transform var(--transition-fast); }
.hero__badge:hover svg { transform: translateX(3px); }

.hero__badge-dot {
  width: 7px; height: 7px;
  background: var(--color-accent);
  border-radius: 50%;
  flex-shrink: 0;
  animation: bdot 2.4s ease-in-out infinite;
}

@keyframes bdot {
  0%,100% { box-shadow: 0 0 0 0 rgba(26,127,60,.5); }
  60%      { box-shadow: 0 0 0 5px rgba(26,127,60,0); }
}

/* H1 */
.hero__h1 {
  font-size: clamp(3rem, 5.5vw, 5rem);
  font-weight: 900;
  line-height: 1.0;
  letter-spacing: -0.05em;
  color: var(--color-heading);
  margin-bottom: var(--space-5);
}

.hero__h1-accent {
  color: var(--color-accent);
  position: relative;
  display: inline-block;
}

/* Animated underline drawn in on load */
.hero__h1-accent::after {
  content: '';
  position: absolute;
  inset-inline: 0;
  bottom: 2px;
  height: 5px;
  background: var(--color-accent);
  border-radius: 3px;
  opacity: 0.18;
  transform: scaleX(0);
  transform-origin: left;
  animation: underline-in 0.7s cubic-bezier(0.16,1,0.3,1) 0.3s forwards;
}

@keyframes underline-in {
  to { transform: scaleX(1); }
}

/* Sub */
.hero__sub {
  font-size: clamp(var(--text-base), 1.5vw, var(--text-lg));
  color: var(--color-text-muted);
  line-height: 1.68;
  max-width: 460px;
  margin-bottom: var(--space-8);
}

/* CTA buttons */
.hero__actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-bottom: var(--space-5);
}

.hero__btn-primary {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-base);
  font-weight: 700;
  padding: 0.9375rem 1.875rem;
  border-radius: var(--radius-md);
  border: 2px solid var(--color-accent);
  text-decoration: none;
  letter-spacing: -0.01em;
  /* 3-D press effect */
  box-shadow:
    0 4px 0 0 var(--color-accent-hover),
    0 8px 24px rgba(26,127,60,.22);
  transition:
    transform 120ms ease,
    box-shadow 120ms ease;
}

.hero__btn-primary:hover {
  transform: translateY(-2px);
  box-shadow:
    0 6px 0 0 var(--color-accent-hover),
    0 14px 32px rgba(26,127,60,.28);
}

.hero__btn-primary:active {
  transform: translateY(3px);
  box-shadow: 0 1px 0 0 var(--color-accent-hover);
}

.hero__btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text-muted);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color var(--transition-fast), border-color var(--transition-fast);
  padding-block-end: 1px;
}

.hero__btn-ghost svg { transition: transform var(--transition-fast); }
.hero__btn-ghost:hover { color: var(--color-accent); border-color: var(--color-accent); }
.hero__btn-ghost:hover svg { transform: translateX(4px); }

/* Guarantees list */
.hero__guarantees {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-5);
  margin-bottom: var(--space-8);
}

.hero__guarantees li {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  font-weight: 500;
}

/* Social proof row */
.hero__social-proof {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.hero__avatars {
  display: flex;
}

.hero__av {
  width: 30px; height: 30px;
  border-radius: 50%;
  border: 2px solid #fff;
  margin-inline-start: -7px;
  flex-shrink: 0;
  box-shadow: 0 1px 4px rgba(0,0,0,.12);
}

.hero__avatars .hero__av:first-child { margin-inline-start: 0; }

.hero__sp-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hero__stars { display: flex; gap: 2px; }

.hero__sp-text span {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  font-weight: 500;
}

.hero__sp-text strong { color: var(--color-heading); }

/* ══════════════════════════════════════════════
   PANEL — RIGHT
══════════════════════════════════════════════ */

.hero__panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  /* stagger-in all children */
  --base-delay: 0s;
}

/* Each card animates in sequentially */
.hero__panel > * {
  animation: panelIn 0.6s cubic-bezier(0.16,1,0.3,1) both;
}

.hero__panel > *:nth-child(1) { animation-delay: 0.05s; }
.hero__panel > *:nth-child(2) { animation-delay: 0.20s; }
.hero__panel > *:nth-child(3) { animation-delay: 0.35s; }

@keyframes panelIn {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Base card ── */
.hcard {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  transition: box-shadow var(--transition-base);
}

.hcard:hover { box-shadow: var(--shadow-xl); }

/* ── Main CVR card ── */
.hcard--main {
  padding: var(--space-7) var(--space-8);
  border-top: 3px solid var(--color-accent);
}

.hcard__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}

.hcard__live {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: .06em;
}

.hcard__live-dot {
  width: 7px; height: 7px;
  background: var(--color-success);
  border-radius: 50%;
  animation: bdot 2s infinite;
}

.hcard__win {
  background: #F0FDF4;
  border: 1px solid #BBF7D0;
  color: var(--color-success);
  font-size: var(--text-xs);
  font-weight: 800;
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.hcard__eyebrow {
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  font-weight: 500;
  margin-bottom: var(--space-5);
}

/* Big numbers */
.hcard__bigs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.hcard__big { text-align: center; }

.hcard__big-num {
  display: block;
  font-size: clamp(2.25rem, 3.5vw, 3rem);
  font-weight: 900;
  letter-spacing: -.05em;
  line-height: 1;
}

.hcard__big--before .hcard__big-num,
.hcard__big--before .hcard__big-lbl { color: #DC2626; }
.hcard__big--after  .hcard__big-num { color: var(--color-accent); }

.hcard__big-lbl {
  display: block;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-subtle);
  text-transform: uppercase;
  letter-spacing: .07em;
  margin-top: var(--space-1);
}

.hcard__chevron { flex-shrink: 0; }

/* Bars */
.hcard__bars {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.hcard__bar-row {
  display: grid;
  grid-template-columns: 44px 1fr 36px;
  align-items: center;
  gap: var(--space-3);
}

.hcard__bar-lbl {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-muted);
}

.hcard__bar-track {
  height: 9px;
  background: var(--color-surface-mid);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.hcard__bar-fill {
  height: 100%;
  width: 0;
  border-radius: var(--radius-full);
  animation: barw 1.3s cubic-bezier(.16,1,.3,1) forwards;
}

.hcard__bar-fill--b {
  background: var(--color-surface-dark);
  animation-delay: .5s;
}

.hcard__bar-fill--a {
  background: linear-gradient(90deg, var(--color-accent), #22C55E);
  animation-delay: .75s;
}

@keyframes barw { to { width: var(--w); } }

.hcard__bar-val {
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--color-text-muted);
  text-align: right;
}

.hcard__bar-val--g { color: var(--color-accent); }

.hcard__foot {
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  text-align: center;
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-4);
}

/* ── Row with two small cards ── */
.hcard-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

/* ── Small card base ── */
.hcard--sm {
  padding: var(--space-6);
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.hcard-sm__icon {
  width: 36px; height: 36px;
  border-radius: var(--radius-md);
  background: var(--color-accent-light);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.hcard-sm__icon--blue { background: #EFF6FF; }

.hcard-sm__title {
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-heading);
  margin-bottom: 2px;
  line-height: 1.3;
}

.hcard-sm__sub {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: 1.4;
  margin-bottom: var(--space-2);
}

.hcard-sm__pill {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: 800;
  padding: 2px 8px;
  border-radius: var(--radius-full);
}

.hcard-sm__pill--green {
  background: #F0FDF4;
  color: var(--color-success);
  border: 1px solid #BBF7D0;
}

.hcard-sm__big {
  font-size: var(--text-xl);
  font-weight: 900;
  color: #2563EB;
  letter-spacing: -.03em;
  line-height: 1.1;
}

/* ── Stats strip ── */
.hcard--stats {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  padding: var(--space-6) var(--space-8);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.hstat { text-align: center; }

.hstat__num {
  display: block;
  font-size: var(--text-2xl);
  font-weight: 900;
  letter-spacing: -.04em;
  color: var(--color-heading);
  line-height: 1;
}

.hstat__lbl {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
  font-weight: 500;
}

/* ══════════════════════════════════════════════
   LOGO STRIP
══════════════════════════════════════════════ */

.hero__logos {
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  padding: var(--space-7) 0;
}

.hero__logos-lbl {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
  text-align: center;
  margin-bottom: var(--space-5);
}

.hero__logos-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(var(--space-6), 4vw, var(--space-12));
  flex-wrap: wrap;
  opacity: .32;
  filter: grayscale(1);
}

.hero__logo svg { width: 90px; height: 24px; }

/* ══════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════ */

/* Tablet landscape — tighten but keep both columns */
@media (max-width: 1080px) {
  .hcard--main { padding: var(--space-5) var(--space-6); }
  .hcard__big-num { font-size: 2.25rem; }
}

/* Tablet portrait — stack columns, panel below */
@media (max-width: 860px) {
  .hero__grid {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-block-end: var(--space-12);
    gap: var(--space-10);
  }

  /* Panel: show only main card + stats on tablet */
  .hcard-row { display: none; }

  .hero__panel {
    /* Horizontal mini layout on tablet */
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--space-3);
  }

  .hcard--stats {
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, 1fr);
  }
}

/* Mobile — copy only, hide entire panel */
@media (max-width: 640px) {
  .hero { padding-block-start: var(--space-10); }

  .hero__h1 { font-size: clamp(2.5rem, 11vw, 3.5rem); }

  .hero__panel { display: none; }

  .hero__sub { max-width: 100%; }

  .hero__actions { flex-direction: column; align-items: flex-start; }

  .hero__btn-primary { width: 100%; justify-content: center; }

