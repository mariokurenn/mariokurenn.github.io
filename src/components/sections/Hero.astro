---
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">

    <!-- Badge -->
    <a href="/services/cro-audit/" class="hero__badge">
      <span class="hero__badge-dot" aria-hidden="true"></span>
      47-point CRO Audit — free, no commitment
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

    <!-- H1 -->
    <h1 class="hero__h1" id="hero-heading">
      97% of Your Visitors<br />
      Leave Without <span class="hero__h1-accent">Buying.</span>
    </h1>

    <!-- Subheadline -->
    <p class="hero__sub">
      Data-driven CRO that finds exactly what's costing you conversions —
      then systematically fixes it. Average client sees a <strong>127% CVR increase</strong> within 90 days.
    </p>

    <!-- CTAs -->
    <div class="hero__actions">
      <a href="/contact/" class="hero__btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Book Your Free Audit
      </a>
      <a href="#results" class="hero__btn-ghost">
        See client results
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Guarantees -->
    <ul class="hero__guarantees" aria-label="Guarantees">
      {[
        'Free audit — no credit card',
        'First results within 30 days',
        'Month-to-month, no lock-in',
      ].map((g) => (
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          {g}
        </li>
      ))}
    </ul>

    <!-- Social proof -->
    <div class="hero__social-proof">
      <div class="hero__avatars" aria-hidden="true">
        {[
          '/images/avatars/reviewer-1.webp',
          '/images/avatars/reviewer-2.webp',
          '/images/avatars/reviewer-3.webp',
          '/images/avatars/reviewer-4.webp',
          '/images/avatars/reviewer-5.webp',
        ].map((src) => (
          <img src={src} alt="" class="hero__av" width="30" height="30" loading="eager" decoding="async" fetchpriority="low" />
        ))}
      </div>
      <div class="hero__sp-text">
        <div class="hero__stars" aria-label="Rated 4.9 out of 5">
          {Array.from({length:5}).map(() => (
            <svg width="13" height="13" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ))}
        </div>
        <span><strong>4.9/5</strong> · 47 reviews · 50+ businesses optimised</span>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="hero__stats" aria-label="Key results">
      {[
        { n:'127', s:'%', l:'Avg. CVR increase' },
        { n:'800', s:'+', l:'A/B tests run' },
        { n:'4.8', s:'×', l:'Avg. ROI delivered' },
      ].map(({ n, s, l }) => (
        <div class="hero__stat">
          <span class="hero__stat-num" data-count={n} data-suffix={s}>0{s}</span>
          <span class="hero__stat-lbl">{l}</span>
        </div>
      ))}
    </div>

  </div>

  <!-- Logo strip -->
  <div class="hero__logos">
    <div class="container">
      <p class="hero__logos-lbl">Proven with e-commerce, SaaS, and lead-gen businesses</p>
      <div class="hero__logos-row">
        {[
          '/images/logos/client-1.png',
          '/images/logos/client-2.svg',
          '/images/logos/client-3.png',
          '/images/logos/client-4.png',
          '/images/logos/client-5.webp',
          '/images/logos/client-6.png',
        ].map((src) => (
          <div class="hero__logo">
            <img src={src} alt="" loading="eager" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  background: var(--gradient-hero);
  background-image:
    radial-gradient(var(--color-border) 1px, transparent 1px),
    var(--gradient-hero);
  background-size: 28px 28px, auto;
  overflow: hidden;
}

.hero__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-block: clamp(var(--space-14), 8vw, var(--space-20));
  max-width: 800px;
}

/* Badge */
.hero__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-accent-light);
  border: 1px solid rgba(26,127,60,0.2);
  color: var(--color-accent);
  font-size: var(--text-xs);
  font-weight: 700;
  padding: 0.35rem 0.875rem;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-6);
  text-decoration: none;
  transition: background var(--transition-fast), box-shadow var(--transition-fast);
}

.hero__badge:hover {
  background: rgba(26,127,60,0.12);
  box-shadow: 0 0 0 3px rgba(26,127,60,0.1);
}

.hero__badge svg { flex-shrink: 0; transition: transform var(--transition-fast); }
.hero__badge:hover svg { transform: translateX(3px); }

.hero__badge-dot {
  width: 7px; height: 7px;
  background: var(--color-accent);
  border-radius: 50%;
  flex-shrink: 0;
  animation: bdot 2.4s ease-in-out infinite;
}

@keyframes bdot {
  0%,100% { box-shadow: 0 0 0 0 rgba(26,127,60,.5); }
  60%      { box-shadow: 0 0 0 5px rgba(26,127,60,0); }
}

/* H1 */
.hero__h1 {
  font-size: clamp(2.5rem, 4.5vw, 4rem);
  font-weight: 900;
  line-height: 1.0;
  letter-spacing: -0.05em;
  color: var(--color-heading);
  margin-bottom: var(--space-6);
}

.hero__h1-accent {
  color: var(--color-accent);
  position: relative;
  display: inline-block;
}

.hero__h1-accent::after {
  content: '';
  position: absolute;
  inset-inline: 0;
  bottom: 2px;
  height: 5px;
  background: var(--color-accent);
  border-radius: 3px;
  opacity: 0.18;
  transform: scaleX(0);
  transform-origin: left;
  animation: underline-in 0.7s cubic-bezier(0.16,1,0.3,1) 0.3s forwards;
}

@keyframes underline-in { to { transform: scaleX(1); } }

/* Sub */
.hero__sub {
  font-size: clamp(var(--text-base), 1.5vw, var(--text-lg));
  color: var(--color-text-muted);
  line-height: 1.7;
  max-width: 580px;
  margin-bottom: var(--space-8);
}

/* CTAs */
.hero__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-bottom: var(--space-5);
}

.hero__btn-primary {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-base);
  font-weight: 700;
  padding: 0.9375rem 1.875rem;
  border-radius: var(--radius-md);
  border: 2px solid var(--color-accent);
  text-decoration: none;
  letter-spacing: -0.01em;
  box-shadow:
    0 4px 0 0 var(--color-accent-hover),
    0 8px 24px rgba(26,127,60,.22);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.hero__btn-primary:hover {
  transform: translateY(-2px);
  box-shadow:
    0 6px 0 0 var(--color-accent-hover),
    0 14px 32px rgba(26,127,60,.28);
}

.hero__btn-primary:active {
  transform: translateY(3px);
  box-shadow: 0 1px 0 0 var(--color-accent-hover);
}

.hero__btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text-muted);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color var(--transition-fast), border-color var(--transition-fast);
  padding-block-end: 1px;
}

.hero__btn-ghost svg { transition: transform var(--transition-fast); }
.hero__btn-ghost:hover { color: var(--color-accent); border-color: var(--color-accent); }
.hero__btn-ghost:hover svg { transform: translateX(4px); }

/* Guarantees */
.hero__guarantees {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-2) var(--space-5);
  margin-bottom: var(--space-8);
}

.hero__guarantees li {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  font-weight: 500;
}

/* Social proof */
.hero__social-proof {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-bottom: var(--space-10);
}

.hero__avatars { display: flex; }

.hero__av {
  width: 30px; height: 30px;
  border-radius: 50%;
  border: 2px solid #fff;
  margin-inline-start: -7px;
  flex-shrink: 0;
  box-shadow: 0 1px 4px rgba(0,0,0,.12);
  object-fit: cover;
  display: block;
}

.hero__avatars .hero__av:first-child { margin-inline-start: 0; }

.hero__sp-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hero__stars { display: flex; gap: 2px; }

.hero__sp-text span {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  font-weight: 500;
}

.hero__sp-text strong { color: var(--color-heading); }

/* Stats strip */
.hero__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  width: 100%;
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
}

.hero__stat {
  padding: var(--space-6) var(--space-5);
  text-align: center;
  border-right: 1px solid var(--color-border);
}

.hero__stat:last-child { border-right: none; }

.hero__stat-num {
  display: block;
  font-size: var(--text-3xl);
  font-weight: 900;
  letter-spacing: -0.04em;
  color: var(--color-heading);
  line-height: 1;
}

.hero__stat-lbl {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
  font-weight: 500;
}

/* Logo strip */
.hero__logos {
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  padding: var(--space-7) 0;
}

.hero__logos-lbl {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
  text-align: center;
  margin-bottom: var(--space-5);
}

.hero__logos-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  flex-wrap: wrap;
}

.hero__logo img {
  height: 36px;
  width: auto;
  max-width: 140px;
  object-fit: contain;
  display: block;
  filter: brightness(0);
  opacity: 0.55;
  transition: opacity var(--transition-fast);
}

.hero__logo img:hover {
  opacity: 0.9;
}

/* Responsive */
@media (max-width: 640px) {
  .hero__h1 { font-size: clamp(2.5rem, 11vw, 3.5rem); }
  .hero__stats { grid-template-columns: 1fr; }
  .hero__stat { border-right: none; border-bottom: 1px solid var(--color-border); }
  .hero__stat:last-child { border-bottom: none; }
  .hero__logos-row { gap: var(--space-4); }
  .hero__logo img { height: 22px; max-width: 80px; }
}

@media (max-width: 380px) {
  .hero__h1 { font-size: 2.25rem; }
}

@media (prefers-reduced-motion: reduce) {
  .hcard__bar-fill,
  .hero__h1-accent::after,
  .hero__badge-dot {
    animation: none !important;
    opacity: 1 !important;
    width: var(--w, auto) !important;
    transform: none !important;
  }
}
</style>

<script>
  // Animate counter numbers in stats strip
  const nums = document.querySelectorAll<HTMLElement>('.hero__stat-num[data-count]');

  const runCount = (el: HTMLElement) => {
    const target = parseFloat(el.dataset.count ?? '0');
    const suffix = el.dataset.suffix ?? '';
    const isFloat = target % 1 !== 0;
    const dur = 1500;
    const t0 = performance.now();

    const tick = (now: number) => {
      const p = Math.min((now - t0) / dur, 1);
      const e = 1 - (1 - p) ** 3;
      const v = target * e;
      el.textContent = (isFloat ? v.toFixed(1) : Math.floor(v)) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const obs = new IntersectionObserver(
    (entries) => entries.forEach((en) => {
      if (en.isIntersecting) { runCount(en.target as HTMLElement); obs.unobserve(en.target); }
    }),
    { threshold: 0.5 }
  );

  nums.forEach((el) => obs.observe(el));
</script>
