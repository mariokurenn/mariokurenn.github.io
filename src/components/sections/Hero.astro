  .hero__h1 { font-size: 2.25rem; }
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  .hero__panel > *,
  .hcard__bar-fill,
  .hero__h1-accent::after,
  .hero__badge-dot,
  .hcard__live-dot {
    animation: none !important;
    opacity: 1 !important;
    width: var(--w, auto) !important;
    transform: none !important;
  }
}
</style>

<script>
  // Animate counter numbers in stats strip
  const nums = document.querySelectorAll<HTMLElement>('.hstat__num[data-count]');

  const runCount = (el: HTMLElement) => {
    const target = parseFloat(el.dataset.count ?? '0');
    const suffix = el.dataset.suffix ?? '';
    const isFloat = target % 1 !== 0;
    const dur = 1500;
    const t0 = performance.now();

    const tick = (now: number) => {
      const p = Math.min((now - t0) / dur, 1);
      const e = 1 - (1 - p) ** 3; // ease-out cubic
      const v = target * e;
      el.textContent = (isFloat ? v.toFixed(1) : Math.floor(v)) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const obs = new IntersectionObserver(
    (entries) => entries.forEach((en) => {
      if (en.isIntersecting) { runCount(en.target as HTMLElement); obs.unobserve(en.target); }
    }),
    { threshold: 0.5 }
  );

  nums.forEach((el) => obs.observe(el));
</script>
