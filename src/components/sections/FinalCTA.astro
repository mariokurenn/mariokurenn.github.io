---
interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  title    = "Ready to Stop Leaving Money on the Table?",
  subtitle = "Most businesses convert at 2–3%. Top performers hit 8–12%. The difference is systematic CRO. Let's build your roadmap.",
  ctaText  = "Book Your Free Strategy Call",
  ctaHref  = "/contact/",
} = Astro.props;
---

<section class="final-cta section--tight" aria-labelledby="final-cta-heading">
  <div class="container">
    <div class="final-cta__inner">
      <span class="section-label">Get Started</span>
      <h2 class="final-cta__title" id="final-cta-heading">{title}</h2>
      <p class="final-cta__subtitle">{subtitle}</p>
      <div class="final-cta__actions">
        <a href={ctaHref} class="btn btn--primary btn--lg">
          {ctaText}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="final-cta__guarantee">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Free audit. No commitment. No credit card.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--color-heading);
    text-align: center;
  }

  .final-cta .section-label {
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-4);
  }

  .final-cta .section-label::before {
    background: var(--color-accent);
    display: none;
  }

  .final-cta__inner {
    max-width: 640px;
    margin-inline: auto;
    padding: var(--space-16) 0;
  }

  .final-cta__title {
    font-size: clamp(1.875rem, 4vw, 2.875rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--color-white);
    margin-bottom: var(--space-5);
  }

  .final-cta__subtitle {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.65);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .final-cta__actions { margin-bottom: var(--space-5); }

  .final-cta .btn--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 4px 24px rgba(26, 127, 60, 0.4);
    font-size: var(--text-lg);
  }

  .final-cta .btn--primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    box-shadow: 0 6px 32px rgba(26, 127, 60, 0.5);
  }

  .final-cta__guarantee {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.5);
    font-weight: 500;
  }
</style>
