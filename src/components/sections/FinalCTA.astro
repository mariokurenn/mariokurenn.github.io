---
interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  title    = "Ready to Stop Leaving Revenue on the Table?",
  subtitle = "Most businesses convert at 2–3%. Top performers hit 8–12%. The difference is systematic CRO. Let's find your leaks and fix them.",
  ctaText  = "Book Your Free Audit",
  ctaHref  = "/contact/",
} = Astro.props;

const trustItems = [
  { text: "Free audit — no credit card" },
  { text: "First test results in weeks, not quarters" },
  { text: "Month-to-month after onboarding" },
];
---

<section class="final-cta section--tight" aria-labelledby="final-cta-heading">
  <div class="container">
    <div class="final-cta__inner">

      <div class="final-cta__proof">
        <div class="final-cta__avatars" aria-hidden="true">
          {[
            '/images/avatars/reviewer-1.webp',
            '/images/avatars/reviewer-2.webp',
            '/images/avatars/reviewer-3.webp',
            '/images/avatars/reviewer-4.webp',
            '/images/avatars/reviewer-5.webp',
          ].map((src, i) => (
            <img
              src={src}
              alt=""
              class="final-cta__av"
              width="24" height="24"
              loading="lazy"
              decoding="async"
            />
          ))}
          <span class="final-cta__av final-cta__av--more">50+</span>
        </div>
        <span>Join 50+ businesses already compounding their conversion rate</span>
      </div>

      <h2 class="final-cta__title" id="final-cta-heading">{title}</h2>
      <p class="final-cta__subtitle">{subtitle}</p>

      <div class="final-cta__actions">
        <a href={ctaHref} class="btn btn--primary btn--lg">
          {ctaText}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <ul class="final-cta__trust" aria-label="Guarantees">
        {trustItems.map(({ text }) => (
          <li>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="3" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            {text}
          </li>
        ))}
      </ul>

    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--color-heading);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* Subtle radial accent glow */
  .final-cta::before {
    content: '';
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(26, 127, 60, 0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .final-cta__inner {
    max-width: 640px;
    margin-inline: auto;
    padding: var(--space-16) 0;
    position: relative;
    z-index: 1;
  }

  /* Social proof strip above heading */
  .final-cta__proof {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-full);
    padding: 0.375rem 1rem 0.375rem 0.5rem;
    margin-bottom: var(--space-7);
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.01em;
  }

  .final-cta__avatars {
    display: flex;
  }

  .final-cta__av {
    width: 24px; height: 24px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.25);
    margin-inline-start: -5px;
    flex-shrink: 0;
    object-fit: cover;
    display: block;
  }

  .final-cta__av--more {
    background: rgba(255,255,255,0.15);
    color: white;
    font-size: 8px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: -0.03em;
  }

  .final-cta__avatars .final-cta__av:first-child { margin-inline-start: 0; }

  .final-cta__title {
    font-size: clamp(1.875rem, 4vw, 2.875rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--color-white);
    margin-bottom: var(--space-5);
  }

  .final-cta__subtitle {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.60);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .final-cta__actions { margin-bottom: var(--space-6); }

  .final-cta .btn--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    font-size: var(--text-lg);
    box-shadow:
      0 4px 0 0 var(--color-accent-hover),
      0 8px 40px rgba(26, 127, 60, 0.40);
  }

  .final-cta .btn--primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    box-shadow:
      0 6px 0 0 #0f4d22,
      0 12px 48px rgba(26, 127, 60, 0.50);
  }

  .final-cta__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .final-cta__trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.45);
    font-weight: 500;
  }
</style>
