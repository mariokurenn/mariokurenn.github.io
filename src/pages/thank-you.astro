---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Request Received — conversionrate-expert.com"
  description="Your CRO audit request has been received. We'll review your site and be in touch within 24 hours."
>
  <div class="thankyou-page">
    <div class="container thankyou-inner">
      <div class="thankyou-icon" aria-hidden="true">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="1.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <h1 class="thankyou-title">Request Received</h1>
      <p class="thankyou-sub">
        We've got your details and will review your site within <strong>24 hours</strong>.
        Expect a calendar invite from Mario to book your free audit call.
      </p>
      <div class="thankyou-actions">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/blog/" class="btn btn--ghost">Read the Blog</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .thankyou-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thankyou-inner {
    text-align: center;
    max-width: 540px;
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
  }

  .thankyou-icon {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .thankyou-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .thankyou-sub {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-10);
  }

  .thankyou-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
