---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist. Head back to conversionrate-expert.com."
>
  <div class="notfound-page">
    <div class="container notfound-inner">
      <div class="notfound-code" aria-hidden="true">404</div>
      <h1 class="notfound-title">Page Not Found</h1>
      <p class="notfound-sub">
        This page doesn't exist — or was moved. No conversion happening here.
      </p>
      <div class="notfound-actions">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/contact/" class="btn btn--ghost">Get a Free Audit</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .notfound-inner {
    text-align: center;
    max-width: 520px;
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
  }

  .notfound-code {
    font-size: clamp(6rem, 18vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--color-border);
    margin-bottom: var(--space-4);
    user-select: none;
  }

  .notfound-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .notfound-sub {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-10);
  }

  .notfound-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
