---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCollection('case-studies', ({ data }) => !data.draft);
  return cases.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'case-studies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, seoTitle, description, client, clientUrl, industry, duration, services, results, testimonial, publishDate } = entry.data;

const siteURL = 'https://grow-conversions.com';
const pageURL = `${siteURL}/case-studies/${entry.slug}/`;

const caseStudySchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: pageURL,
  datePublished: publishDate.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Mario Kuren',
    url: `${siteURL}/author/mario-kuren/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'grow-conversions.com',
    url: siteURL,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${siteURL}/case-studies/` },
    { '@type': 'ListItem', position: 3, name: client, item: pageURL },
  ],
};
---

<BaseLayout title={seoTitle ?? title} description={description} jsonLd={[caseStudySchema, breadcrumbSchema]}>
  <article class="case-page">
    <!-- Header -->
    <div class="case-header">
      <div class="container ">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <a href="/case-studies/">Case Studies</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">{client}</span>
        </nav>

        <div class="case-header__badges">
          <span class="badge badge--accent">{industry}</span>
          {duration && <span class="badge">{duration}</span>}
        </div>

        <h1 class="case-header__title">{title}</h1>
        <p class="case-header__desc">{description}</p>

        <div class="case-header__services">
          {services.map((s) => (
            <span class="case-service-tag">{s}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Results bar -->
    <div class="case-results-bar">
      <div class="container">
        <div class="case-results-grid">
          {results.map(({ metric, before, after, change }) => (
            <div class="case-result">
              <div class="case-result__change">{change}</div>
              <div class="case-result__metric">{metric}</div>
              <div class="case-result__detail">{before} → {after}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Content layout -->
    <div class="container case-layout">
      <!-- Main content -->
      <div class="case-body prose">
        <Content />
      </div>

      <!-- Sidebar -->
      <aside class="case-sidebar">
        <!-- Client info -->
        <div class="case-sidebar__card">
          <p class="case-sidebar__label">Client</p>
          {clientUrl ? (
            <a href={clientUrl} target="_blank" rel="noopener noreferrer" class="case-sidebar__client-link">
              {client} →
            </a>
          ) : (
            <p class="case-sidebar__value">{client}</p>
          )}
          <p class="case-sidebar__label" style="margin-top: var(--space-4)">Industry</p>
          <p class="case-sidebar__value">{industry}</p>
          {duration && (
            <>
              <p class="case-sidebar__label" style="margin-top: var(--space-4)">Duration</p>
              <p class="case-sidebar__value">{duration}</p>
            </>
          )}
          <p class="case-sidebar__label" style="margin-top: var(--space-4)">Services</p>
          <div class="case-sidebar__services">
            {services.map((s) => <span class="case-service-tag case-service-tag--sm">{s}</span>)}
          </div>
        </div>

        <!-- Testimonial -->
        {testimonial && (
          <div class="case-sidebar__testimonial">
            <blockquote class="case-testimonial__quote">"{testimonial.quote}"</blockquote>
            <p class="case-testimonial__author">— {testimonial.author}, {testimonial.role}</p>
          </div>
        )}

        <!-- CTA -->
        <div class="case-sidebar__cta">
          <p class="case-sidebar__cta-eyebrow">Want similar results?</p>
          <h3 class="case-sidebar__cta-title">Get a Free CRO Audit</h3>
          <p class="case-sidebar__cta-body">We'll identify your biggest conversion leaks and give you a prioritised action plan — free, no strings.</p>
          <a href="/contact/" class="btn btn--primary" style="width:100%;justify-content:center">
            Book Free Audit →
          </a>
          <p class="case-sidebar__cta-note">Free · No commitment · 24h response</p>
        </div>
      </aside>
    </div>

    <!-- Back link -->
    <div class="container case-back">
      <a href="/case-studies/" class="btn btn--secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        All Case Studies
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .case-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-12) 0 var(--space-10);
  }

  .case-header__inner { max-width: 800px; }

  .case-header__badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .case-header__title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .case-header__desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .case-header__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .case-service-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.75rem;
    color: var(--color-text-muted);
  }

  .case-service-tag--sm { font-size: 10px; }

  /* Results bar */
  .case-results-bar {
    background: var(--color-heading);
    padding: var(--space-8) 0;
  }

  .case-results-grid {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
    justify-content: center;
  }

  .case-result {
    text-align: center;
    min-width: 120px;
  }

  .case-result__change {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 900;
    color: #4ade80;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .case-result__metric {
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    margin-top: var(--space-1);
  }

  .case-result__detail {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.5);
    margin-top: 2px;
  }

  /* Layout */
  .case-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-16);
    align-items: start;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .case-body { min-width: 0; }

  /* Sidebar */
  .case-sidebar {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .case-sidebar__card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .case-sidebar__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-1);
  }

  .case-sidebar__value {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-heading);
  }

  .case-sidebar__client-link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .case-sidebar__client-link:hover { text-decoration: underline; }

  .case-sidebar__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .case-sidebar__testimonial {
    background: var(--color-accent-light);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .case-testimonial__quote {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-3);
  }

  .case-testimonial__author {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
  }

  .case-sidebar__cta {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .case-sidebar__cta-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .case-sidebar__cta-title {
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .case-sidebar__cta-body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .case-sidebar__cta-note {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-align: center;
    margin-top: var(--space-3);
  }

  .case-back {
    padding-bottom: var(--space-16);
  }

  @media (max-width: 900px) {
    .case-layout {
      grid-template-columns: 1fr;
    }
    .case-sidebar {
      position: static;
      order: -1;
    }
    .case-results-grid {
      gap: var(--space-6);
    }
  }
</style>
