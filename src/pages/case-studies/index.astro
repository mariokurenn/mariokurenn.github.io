---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { getCollection } from 'astro:content';

const siteURL = 'https://grow-conversions.com';

const allCases = await getCollection('case-studies', ({ data }) => !data.draft);
const cases = allCases.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="CRO Case Studies — Real Results from Real Clients"
  description="See how we've helped 50+ businesses improve conversion rates. Real metrics, real strategies, real revenue impact — no fluff."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'CRO Case Studies — grow-conversions.com',
      description: "Real conversion rate optimization results from 50+ client engagements across e-commerce, SaaS, and lead generation.",
      url: `${siteURL}/case-studies/`,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
          { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${siteURL}/case-studies/` },
        ],
      },
      hasPart: cases.map((c) => ({
        '@type': 'Article',
        name: c.data.title,
        description: c.data.description,
        about: c.data.industry,
        url: `${siteURL}/case-studies/${c.slug}/`,
        author: {
          '@type': 'Person',
          name: 'Mario Kuren',
          url: `${siteURL}/author/mario-kuren/`,
        },
      })),
    },
  ]}
>
  <div>
    <div class="page-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">Case Studies</span>
        </nav>
        <h1 class="page-header__title">Results That Speak for Themselves</h1>
        <p class="page-header__subtitle">
          Every case study is a real engagement with real metrics. We don't cherry-pick —
          these represent our standard results across industries and company sizes.
        </p>
      </div>
    </div>

    <section class="section">
      <div class="container">
        <div class="cases-list">
          {cases.map((c) => {
            const primary = c.data.results[0];
            return (
              <a href={`/case-studies/${c.slug}/`} class="case-study-card">
                <div class="case-study-card__left">
                  <div class="case-study-card__meta">
                    <span class="badge badge--accent">{c.data.industry}</span>
                    <div class="case-study-card__services">
                      {c.data.services.map((s) => (
                        <span class="badge badge--surface">{s}</span>
                      ))}
                    </div>
                  </div>
                  <h2 class="case-study-card__client">{c.data.client}</h2>
                  <p class="case-study-card__summary">{c.data.description}</p>
                  <span class="case-study-card__cta">Read case study →</span>
                </div>

                {primary && (
                  <div class="case-study-card__metrics">
                    <div class="case-study-metric">
                      <span class="case-study-metric__label">{primary.metric} Before</span>
                      <span class="case-study-metric__value case-study-metric__value--before">{primary.before}</span>
                    </div>
                    <div class="case-study-metric__arrow" aria-hidden="true">→</div>
                    <div class="case-study-metric">
                      <span class="case-study-metric__label">{primary.metric} After</span>
                      <span class="case-study-metric__value case-study-metric__value--after">{primary.after}</span>
                    </div>
                    <div class="case-study-metric">
                      <span class="case-study-metric__label">Change</span>
                      <span class="case-study-metric__value case-study-metric__value--change">{primary.change}</span>
                    </div>
                  </div>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container" style="max-width: 760px;">
        <h2 class="section-title" style="text-align:left;">How We Measure Results</h2>
        <p style="margin-bottom: var(--space-6); color: var(--color-text);">Every case study on this page represents a real client engagement with before-and-after metrics verified in their analytics. We don't report relative percentage lifts without context, and we don't cherry-pick the one test that worked while ignoring the others. The numbers shown are the primary conversion metric for each engagement — the thing the client actually cared about.</p>
        <p style="color: var(--color-text);">Results vary based on starting baseline, industry, traffic quality, and the size of the problem we're solving. A site with obvious friction points and a low baseline CVR will see larger percentage gains than a site that's already well-optimized. What doesn't vary is the process: research first, hypothesis second, test or implement third, measure and iterate continuously.</p>
      </div>
    </section>

    <FinalCTA
      title="Want Results Like These?"
      subtitle="Every engagement starts with a free audit. We'll identify your biggest opportunities before you spend a cent."
      ctaText="Get Your Free Audit"
    />
  </div>
</BaseLayout>

