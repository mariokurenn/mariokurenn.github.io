---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { getCollection } from 'astro:content';

const siteURL = 'https://grow-conversions.com';

const allCases = await getCollection('case-studies', ({ data }) => !data.draft);
const cases = allCases.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="CRO Case Studies — Real Results from Real Clients"
  description="See how we've helped 50+ businesses improve conversion rates. Real metrics, real strategies, real revenue impact — no fluff."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'CRO Case Studies — grow-conversions.com',
      description: "Real conversion rate optimization results from 50+ client engagements across e-commerce, SaaS, and lead generation.",
      url: `${siteURL}/case-studies/`,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
          { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${siteURL}/case-studies/` },
        ],
      },
      hasPart: cases.map((c) => ({
        '@type': 'Article',
        name: c.data.title,
        description: c.data.description,
        about: c.data.industry,
        url: `${siteURL}/case-studies/${c.slug}/`,
        author: {
          '@type': 'Person',
          name: 'Mario Kuren',
          url: `${siteURL}/author/mario-kuren/`,
        },
      })),
    },
  ]}
>
  <div>
    <div class="page-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">Case Studies</span>
        </nav>
        <h1 class="page-header__title">Results That Speak for Themselves</h1>
        <p class="page-header__subtitle">
          Every case study is a real engagement with real metrics. We don't cherry-pick —
          these represent our standard results across industries and company sizes.
        </p>
      </div>
    </div>

    <section class="section">
      <div class="container">
        <div class="cases-list">
          {cases.map((c) => {
            const primary = c.data.results[0];
            return (
              <a href={`/case-studies/${c.slug}/`} class="case-study-card">
                <div class="case-study-card__left">
                  <div class="case-study-card__meta">
                    <span class="badge badge--accent">{c.data.industry}</span>
                    <div class="case-study-card__services">
                      {c.data.services.map((s) => (
                        <span class="badge badge--surface">{s}</span>
                      ))}
                    </div>
                  </div>
                  <h2 class="case-study-card__client">{c.data.client}</h2>
                  <p class="case-study-card__summary">{c.data.description}</p>
                  <span class="case-study-card__cta">Read case study →</span>
                </div>

                {primary && (
                  <div class="case-study-card__metrics">
                    <div class="case-study-metric">
                      <span class="case-study-metric__label">{primary.metric} Before</span>
                      <span class="case-study-metric__value case-study-metric__value--before">{primary.before}</span>
                    </div>
                    <div class="case-study-metric__arrow" aria-hidden="true">→</div>
                    <div class="case-study-metric">
                      <span class="case-study-metric__label">{primary.metric} After</span>
                      <span class="case-study-metric__value case-study-metric__value--after">{primary.after}</span>
                    </div>
                    <div class="case-study-metric">
                      <span class="case-study-metric__label">Change</span>
                      <span class="case-study-metric__value case-study-metric__value--change">{primary.change}</span>
                    </div>
                  </div>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <FinalCTA
      title="Want Results Like These?"
      subtitle="Every engagement starts with a free audit. We'll identify your biggest opportunities before you spend a cent."
      ctaText="Get Your Free Audit"
    />
  </div>
</BaseLayout>

<style>
  .page-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0;
  }

  .page-header__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: var(--space-4) 0;
  }

  .page-header__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    line-height: 1.6;
  }

  .cases-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-study-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-10);
    align-items: center;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    text-decoration: none;
    color: inherit;
  }

  .case-study-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-accent);
  }

  .case-study-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    margin-top: var(--space-3);
    display: block;
  }

  .case-study-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .case-study-card__services {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .case-study-card__client {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
  }

  .case-study-card__summary {
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 600px;
  }

  .case-study-card__metrics {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-shrink: 0;
  }

  .case-study-metric {
    text-align: center;
  }

  .case-study-metric__label {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .case-study-metric__value {
    display: block;
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1;
  }

  .case-study-metric__value--before { color: var(--color-text-muted); }
  .case-study-metric__value--after { color: var(--color-success); }
  .case-study-metric__value--change { color: var(--color-success); }
  .case-study-metric__value--revenue { color: var(--color-accent); }

  .case-study-metric__arrow {
    font-size: var(--text-2xl);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .case-study-card {
      grid-template-columns: 1fr;
    }

    .case-study-card__metrics {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: var(--space-4);
    }
  }
</style>
