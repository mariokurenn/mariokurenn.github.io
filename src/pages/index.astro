---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import SocialProof from '@/components/sections/SocialProof.astro';
import Services from '@/components/sections/Services.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const siteURL = 'https://conversionrate-expert.com';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'conversionrate-expert.com',
  url: siteURL,
  description: "Data-driven conversion rate optimization agency. We grow businesses by fixing what's leaking.",
  serviceType: 'Conversion Rate Optimization',
  areaServed: 'Worldwide',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '47',
  },
};

const featuredCaseStudies = [
  {
    client: 'E-commerce Brand',
    industry: 'Retail',
    before: '2.1%',
    after: '4.8%',
    change: '+128%',
    service: 'Full CRO Program',
    description: '90-day program including landing page redesign, checkout optimization, and A/B testing roadmap.',
  },
  {
    client: 'SaaS Platform',
    industry: 'Software',
    before: '3.4%',
    after: '7.9%',
    change: '+132%',
    service: 'Landing Page + A/B Testing',
    description: 'Free trial page redesign and 12-week A/B testing program. Result: 132% more trials from same traffic.',
  },
  {
    client: 'Lead Gen Business',
    industry: 'B2B Services',
    before: '4.1%',
    after: '11.2%',
    change: '+173%',
    service: 'CRO Audit + Implementation',
    description: 'Audit revealed 23 critical issues. 8 weeks of implementation increased qualified leads by 173%.',
  },
];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---

<BaseLayout
  title="Conversion Rate Optimization Agency | CRO Expert"
  description="We grow businesses by fixing what's leaking. Data-driven CRO agency — audits, A/B testing, landing page optimization. Average 127% CVR increase."
  jsonLd={organizationSchema}
>
  <!-- 1. HERO -->
  <Hero />

  <!-- 2. SOCIAL PROOF STATS -->
  <SocialProof />

  <!-- 3. PROBLEM -->
  <section class="problem section section--surface" aria-labelledby="problem-heading">
    <div class="container">
      <div class="problem__inner">
        <div class="problem__content">
          <span class="section-label">Sound Familiar?</span>
          <h2 class="section-title" id="problem-heading">
            Your Traffic Is Expensive.<br />
            Your Conversions Are Not Keeping Up.
          </h2>
          <ul class="problem__list">
            {[
              "You're spending thousands on ads but CVR hasn't moved in months",
              "Your analytics show traffic — but revenue doesn't reflect it",
              "You've redesigned your landing page and conversions got worse, not better",
              "You don't know which changes would actually make a difference",
              "Your competitors convert at a higher rate with less traffic",
              "You're optimizing based on gut feeling, not data",
            ].map((item) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <p class="problem__footer">
            These are symptoms of an unoptimized funnel. We've seen it hundreds of times — and we know exactly how to fix it.
          </p>
        </div>

        <!-- Funnel visual -->
        <div class="problem__visual" aria-hidden="true">
          <div class="funnel-card">
            <p class="funnel-card__title">Typical E-commerce Funnel</p>
            {[
              { label: 'Visitors', value: '10,000', pct: 100 },
              { label: 'Product Views', value: '4,200', pct: 42 },
              { label: 'Add to Cart', value: '840', pct: 8.4 },
              { label: 'Checkout', value: '380', pct: 3.8 },
              { label: 'Purchase', value: '210', pct: 2.1 },
            ].map(({ label, value, pct }) => (
              <div class="funnel-step">
                <div class="funnel-step__info">
                  <span>{label}</span>
                  <span class="funnel-step__value">{value}</span>
                </div>
                <div class="funnel-step__track">
                  <div class="funnel-step__fill" style={`width: ${pct}%`}></div>
                </div>
              </div>
            ))}
            <div class="funnel-card__leak">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              97.9% of visitors leave without buying
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS -->
  <section class="how-it-works section" aria-labelledby="how-heading">
    <div class="container">
      <span class="section-label">Our Process</span>
      <h2 class="section-title" id="how-heading">From Audit to Revenue in 3 Steps</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-14);">
        We don't guess. We research, test, and iterate — using a proven process that has generated measurable revenue lifts for 50+ businesses.
      </p>

      <div class="process-steps">
        {[
          {
            step: '01',
            title: 'Research & Audit',
            description: "We dig into your analytics, run heatmaps, study session recordings, and interview users. We find exactly where and why visitors are dropping off.",
            duration: 'Week 1–2',
          },
          {
            step: '02',
            title: 'Strategy & Testing',
            description: "We build a prioritized hypothesis backlog and start running A/B tests. Every test is statistically rigorous — no false positives, no wasted cycles.",
            duration: 'Week 3–10',
          },
          {
            step: '03',
            title: 'Implement & Compound',
            description: "Winners get implemented. Each test builds on the last. Your conversion rate compounds over time and your learnings become a competitive advantage.",
            duration: 'Ongoing',
          },
        ].map(({ step, title, description, duration }) => (
          <div class="process-step">
            <div class="process-step__num" aria-hidden="true">{step}</div>
            <div class="process-step__body">
              <div class="process-step__header">
                <h3 class="process-step__title">{title}</h3>
                <span class="badge badge--surface">{duration}</span>
              </div>
              <p class="process-step__desc">{description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. SERVICES -->
  <Services />

  <!-- 6. RESULTS -->
  <section class="results section section--surface" id="results" aria-labelledby="results-heading">
    <div class="container">
      <span class="section-label">Results</span>
      <h2 class="section-title" id="results-heading">Numbers Don't Lie</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-12);">
        Real results from real clients. Every metric is from an actual engagement.
      </p>

      <div class="results__grid">
        {featuredCaseStudies.map(({ client, industry, before, after, change, service, description }) => (
          <article class="result-card">
            <div class="result-card__header">
              <div>
                <p class="result-card__client">{client}</p>
                <p class="result-card__meta">{industry} · {service}</p>
              </div>
              <span class="result-card__change">{change}</span>
            </div>
            <div class="result-card__cvr">
              <span class="result-card__before">{before}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-subtle)" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
              <span class="result-card__after">{after}</span>
              <span class="result-card__label">CVR</span>
            </div>
            <p class="result-card__description">{description}</p>
          </article>
        ))}
      </div>

      <div style="text-align: center; margin-top: var(--space-10);">
        <a href="/case-studies/" class="btn btn--secondary">
          View All Case Studies
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. TESTIMONIALS -->
  <Testimonials />

  <!-- 8. BLOG PREVIEW -->
  {latestPosts.length > 0 && (
    <section class="blog-preview section" aria-labelledby="blog-heading">
      <div class="container">
        <div class="blog-preview__header">
          <div>
            <span class="section-label">CRO Insights</span>
            <h2 class="section-title" id="blog-heading">Learn From the Experts</h2>
          </div>
          <a href="/blog/" class="btn btn--secondary">View All Posts</a>
        </div>
        <div class="grid-3">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="blog-card">
              <div class="blog-card__image">
                <div class="blog-card__img-placeholder" aria-hidden="true"></div>
              </div>
              <div class="blog-card__body">
                <p class="blog-card__category">{post.data.category}</p>
                <h3 class="blog-card__title">{post.data.title}</h3>
                <p class="blog-card__excerpt">{post.data.description}</p>
                <div class="blog-card__meta">
                  <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{post.data.author}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 9. FINAL CTA -->
  <FinalCTA />
</BaseLayout>

<style>
  /* Problem section */
  .problem__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .problem__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-8) 0;
  }

  .problem__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .problem__list svg { flex-shrink: 0; margin-top: 2px; }

  .problem__footer {
    font-size: var(--text-base);
    color: var(--color-heading);
    font-weight: 600;
  }

  /* Funnel card */
  .funnel-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
  }

  .funnel-card__title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-6);
  }

  .funnel-step { margin-bottom: var(--space-4); }

  .funnel-step__info {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .funnel-step__value { font-weight: 700; color: var(--color-heading); }

  .funnel-step__track {
    height: 8px;
    background: var(--color-surface-mid);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .funnel-step__fill {
    height: 100%;
    background: linear-gradient(to right, var(--color-accent), #22C55E);
    border-radius: var(--radius-full);
  }

  .funnel-card__leak {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #DC2626;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
  }

  /* Process steps */
  .process-steps {
    display: flex;
    flex-direction: column;
    position: relative;
    max-width: 740px;
  }

  .process-steps::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 56px;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .process-step {
    display: flex;
    gap: var(--space-6);
    padding-bottom: var(--space-10);
    position: relative;
  }

  .process-step:last-child { padding-bottom: 0; }

  .process-step__num {
    width: 56px; height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-base);
    font-weight: 800;
    color: white;
    flex-shrink: 0;
    z-index: 1;
    position: relative;
    box-shadow: 0 0 0 4px var(--color-accent-light);
  }

  .process-step__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .process-step__title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
  }

  .process-step__desc {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* Results */
  .results__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .result-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .result-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .result-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .result-card__client {
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-heading);
  }

  .result-card__meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .result-card__change {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-success);
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .result-card__cvr {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .result-card__before {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-surface-dark);
  }

  .result-card__after {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-success);
  }

  .result-card__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-left: auto;
  }

  .result-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Blog preview */
  .blog-preview__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .blog-card__img-placeholder {
    width: 100%;
    height: 200px;
    background: linear-gradient(135deg, var(--color-surface-mid) 0%, var(--color-surface-dark) 100%);
  }

  @media (max-width: 1024px) {
    .results__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 900px) {
    .problem__inner { grid-template-columns: 1fr; }
    .problem__visual { display: none; }
  }

  @media (max-width: 768px) {
    .results__grid { grid-template-columns: 1fr; }
    .blog-preview__header { flex-direction: column; align-items: flex-start; }
  }
</style>
