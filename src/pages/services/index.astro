---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Services from '@/components/sections/Services.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';

const siteURL = 'https://grow-conversions.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteURL}/services/` },
  ],
};

const serviceListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'CRO Services',
  description: 'Conversion rate optimization services by grow-conversions.com',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'CRO Audit', url: `${siteURL}/services/cro-audit/` },
    { '@type': 'ListItem', position: 2, name: 'A/B Testing', url: `${siteURL}/services/ab-testing/` },
    { '@type': 'ListItem', position: 3, name: 'Landing Page Design', url: `${siteURL}/services/landing-page-design/` },
    { '@type': 'ListItem', position: 4, name: 'Conversion Copywriting', url: `${siteURL}/services/conversion-copywriting/` },
  ],
};
---

<BaseLayout
  title="CRO Services — Conversion Rate Optimization Agency"
  description="Data-driven CRO services: audits, A/B testing, landing page design, and conversion copywriting. We grow your revenue without increasing ad spend."
  jsonLd={[breadcrumbSchema, serviceListSchema]}
>
  <div class="services-page">
    <div class="page-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">Services</span>
        </nav>
        <h1 class="page-header__title">CRO Services That Deliver Measurable Results</h1>
        <p class="page-header__subtitle">
          Every service is built around one goal: increasing the percentage of your visitors who become customers.
          We work with data, not opinions.
        </p>
      </div>
    </div>
    <Services />

    <section class="section">
      <div class="container" style="max-width: 760px;">
        <h2 class="section-title" style="text-align:left;">How We Work</h2>
        <p style="margin-bottom: var(--space-6); color: var(--color-text);">Every engagement starts with data, not assumptions. Before recommending any changes, we audit your analytics, run qualitative research, and map your full conversion funnel. This means we know exactly where visitors are dropping off and why — before we write a single hypothesis.</p>
        <p style="margin-bottom: var(--space-6); color: var(--color-text);">We don't guess. We don't apply generic best practices and call it a day. Every recommendation is grounded in data specific to your site, your audience, and your funnel. The result is a prioritized list of changes ranked by expected revenue impact — so you always know what to fix first.</p>
        <p style="margin-bottom: var(--space-6); color: var(--color-text);">Our clients typically see their first measurable conversion lift within 30–60 days. The compounding effect of systematic testing over 6–12 months is where the largest gains come from. We've helped businesses in e-commerce, SaaS, and B2B lead generation double their conversion rates without increasing ad spend.</p>
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: var(--space-4); color: var(--color-heading);">Who We Work With</h3>
        <p style="color: var(--color-text);">We work best with businesses that have at least 1,000 monthly sessions and a clear conversion goal — whether that's a purchase, a demo request, a sign-up, or a lead form submission. If you're not sure whether CRO is right for your stage, the free audit will tell you. We'll give you an honest assessment of where you stand and what's worth optimising now versus later.</p>
      </div>
    </section>

    <FinalCTA />
  </div>
</BaseLayout>

