---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import CROROICalculator from '@/components/calculators/CROROICalculator.astro';

const siteURL = 'https://grow-conversions.com';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'CRO Audit',
  description: 'A comprehensive 47-point conversion rate optimization audit. We analyze your funnel, landing pages, and user flows to identify what\'s killing your conversions.',
  provider: {
    '@type': 'Organization',
    name: 'grow-conversions.com',
    url: siteURL,
  },
  serviceType: 'CRO Audit',
  areaServed: 'Worldwide',
};

const auditFaqs = [
  {
    question: "Is the free CRO audit really free? What's the catch?",
    answer: "Genuinely free, no strings attached. We do this because it's the most effective way to show you the quality of our work before you commit to anything. You receive a full written report — whether or not you proceed to a paid engagement.",
  },
  {
    question: "How long does a CRO audit take to deliver?",
    answer: "We deliver your report within 7 business days of receiving analytics access. The 47-point audit takes 8–12 hours of our time — that's what 'comprehensive' actually means. You won't get a 15-minute checklist dressed up as an audit.",
  },
  {
    question: "What do we need to provide for the audit?",
    answer: "Read-only access to your Google Analytics 4, a brief on your primary conversion goals, and any existing heatmap data you have. We handle everything else — no lengthy intake forms or technical setup required from your side.",
  },
  {
    question: "How is a CRO audit different from an SEO audit?",
    answer: "An SEO audit focuses on technical factors affecting search rankings. A CRO audit focuses on what happens after visitors arrive — why they don't convert, where the funnel leaks, and how to fix it. They're complementary: SEO brings traffic; CRO makes that traffic valuable.",
  },
  {
    question: "What happens after the audit?",
    answer: "You receive a prioritised action list ranked by estimated revenue impact. You can implement findings yourself, share them with your dev team, or engage us for ongoing CRO. There's no obligation to continue — many clients use the audit as a standalone diagnostic.",
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteURL}/services/` },
    { '@type': 'ListItem', position: 3, name: 'CRO Audit', item: `${siteURL}/services/cro-audit/` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: auditFaqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const auditPoints = [
  { category: 'Analytics & Data', items: ['GA4 funnel analysis', 'Drop-off point identification', 'Segment performance', 'Traffic source quality'] },
  { category: 'UX & Usability', items: ['Heuristic evaluation', 'Mobile usability review', 'Navigation analysis', 'Form friction audit'] },
  { category: 'Landing Pages', items: ['Value prop clarity', 'CTA placement & copy', 'Social proof audit', 'Above-fold review'] },
  { category: 'Trust & Credibility', items: ['Trust signal audit', 'Security indicators', 'Review/rating placement', 'Brand credibility'] },
  { category: 'Checkout/Lead Flow', items: ['Form field count', 'Error message quality', 'Progress indicators', 'Abandonment triggers'] },
  { category: 'Performance', items: ['Core Web Vitals', 'Page speed analysis', 'Mobile performance', 'Render-blocking resources'] },
];
---

<BaseLayout
  title="Free CRO Audit — 47 Checks That Uncover Your Hidden Revenue Leaks"
  description="47-point audit finds every conversion blocker and ranks fixes by revenue impact. Annotated screenshots + 90-day A/B test roadmap included. Free for qualifying businesses."
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <!-- Hero -->
  <div class="service-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumbs__separator" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumbs__separator" aria-hidden="true">/</span>
        <span class="breadcrumbs__current" aria-current="page">CRO Audit</span>
      </nav>
      <span class="section-label">Service</span>
      <h1 class="service-hero__title">The 47-Point CRO Audit That Finds Your Hidden Revenue</h1>
      <p class="service-hero__subtitle">
        Most businesses are bleeding conversions from 5–10 critical issues. Our audit finds them all,
        ranks them by revenue impact, and gives you a step-by-step fix plan.
      </p>
      <div class="service-hero__actions">
        <a href="/contact/" class="btn btn--primary btn--lg">Get Your Free CRO Audit</a>
        <div class="service-hero__proof">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Free for qualifying businesses · No commitment required</span>
        </div>
      </div>
    </div>
  </div>

  <!-- What's included -->
  <section class="section">
    <div class="container">
      <span class="section-label">What You Get</span>
      <h2 class="section-title">47 Checks Across 6 Critical Areas</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-12);">
        Every audit covers the full funnel — from the moment a visitor lands to the moment they convert (or don't).
      </p>
      <div class="audit-grid">
        {auditPoints.map(({ category, items }) => (
          <div class="audit-category">
            <h3 class="audit-category__title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {category}
            </h3>
            <ul class="audit-category__list">
              {items.map((item) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="1"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div class="container">
      <span class="section-label">Deliverables</span>
      <h2 class="section-title">What You Receive After the Audit</h2>
      <div class="deliverables-grid">
        {[
          { title: 'Priority Issue List', description: 'Every conversion blocker ranked by estimated revenue impact — so you know exactly where to start.' },
          { title: 'Annotated Screenshots', description: 'Visual markup of exactly what to fix on each page, with explanations your developer can act on immediately.' },
          { title: 'A/B Test Roadmap', description: 'A 90-day testing roadmap with 10+ hypotheses prioritized by PIE score (Potential, Importance, Ease).' },
          { title: 'Benchmarks Report', description: 'How your conversion metrics compare to industry benchmarks, so you know where the biggest gaps are.' },
        ].map(({ title, description }) => (
          <div class="card">
            <svg class="card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <h3 class="card__title">{title}</h3>
            <p class="card__body">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What a CRO Audit Actually Is -->
  <section class="section">
    <div class="container" style="max-width: 760px;">
      <h2 class="section-title" style="text-align:left;">What a CRO Audit Actually Is</h2>
      <p style="margin-bottom: var(--space-6); color: var(--color-text);">A CRO audit is a systematic review of everything that affects your conversion rate — from the moment a visitor lands on your site to the moment they complete (or abandon) your goal action. It combines quantitative analysis (your actual traffic, funnel, and drop-off data) with qualitative research (session recordings, heatmaps, and user feedback) to produce a prioritized list of what to fix and in what order.</p>
      <p style="margin-bottom: var(--space-6); color: var(--color-text);">The output isn't a generic best-practices checklist. It's a diagnosis specific to your site, your audience, and your funnel. Two sites in the same industry with the same conversion rate can have completely different problems. The audit tells you exactly which of the 47 checkpoints are failing for your specific visitors — and ranks them by estimated revenue impact so you know where to start.</p>
      <p style="color: var(--color-text);">Most businesses that come to us for an audit discover that 80% of their lost conversions are coming from 3–5 specific issues. Often, at least one of those issues is invisible to the team because they test their own site on a fast desktop connection with a trusted browser. Real visitors experience something different. The audit shows you what they actually see.</p>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div class="container" style="max-width: 760px;">
      <h2 class="section-title" style="text-align:left;">What's Your CVR Improvement Worth?</h2>
      <p style="margin-bottom: var(--space-6); color: var(--color-text);">Before committing to a CRO programme, it's worth knowing the potential upside. Use this calculator to see how much additional revenue a conversion rate improvement would generate from your existing traffic.</p>
      <CROROICalculator />
    </div>
  </section>

  <!-- Blog resource link -->
  <section class="section">
    <div class="container">
      <div class="resource-callout">
        <div>
          <span class="section-label">Free Resource</span>
          <h2 class="resource-callout__title">Do Your Own Audit First</h2>
          <p class="resource-callout__desc">
            Before we talk, run through our 37-question CRO audit checklist — the same framework we use
            internally, now available for free. It'll help you understand exactly where to focus.
          </p>
          <a href="/blog/cro-audit-checklist/" class="btn btn--secondary">
            Read: CRO Audit Checklist (37 Questions)
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">Questions About Our CRO Audit</h2>
      <div class="faq-list" style="margin-top: var(--space-10);">
        {auditFaqs.map(({ question, answer }) => (
          <details class="faq-item">
            <summary>
              <span>{question}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </summary>
            <div class="faq-answer">{answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA
    title="Get Your Free CRO Audit"
    subtitle="We offer a free audit for qualifying businesses. Book a 30-minute call, we'll review your site together, and tell you exactly what we'd fix first."
    ctaText="Book My Free Audit Call"
  />
</BaseLayout>

<style>
  .service-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0;
  }
  .service-hero__title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    max-width: 800px;
    margin: var(--space-4) 0;
  }
  .service-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }
  .service-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .service-hero__proof {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .audit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .audit-category {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }
  .audit-category__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }
  .audit-category__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .audit-category__list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .deliverables-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .resource-callout {
    background: linear-gradient(135deg, var(--color-accent-light), rgba(235,247,238,0.3));
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-12);
  }
  .resource-callout__title { font-size: var(--text-2xl); font-weight: 800; letter-spacing: -0.03em; margin: var(--space-3) 0; }
  .resource-callout__desc { color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-6); max-width: 600px; }
  .faq-list { border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--color-border); background: var(--color-white); }
  .faq-item { border-bottom: 1px solid var(--color-border); padding-inline: var(--space-8); }
  .faq-item:last-child { border-bottom: none; }
  .faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-6); font-weight: 600; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-answer { padding-bottom: var(--space-7); color: var(--color-text-muted); line-height: 1.7; }
  @media (max-width: 900px) { .audit-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .audit-grid,
    .deliverables-grid { grid-template-columns: 1fr; }
    .resource-callout { padding: var(--space-8); }
  }
</style>
