---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';

const siteURL = 'https://grow-conversions.com';

const faqs = [
  {
    question: "How long does it take to build a landing page?",
    answer: "Most landing pages are delivered in 10–14 business days. This includes research, wireframing, copy, design, and development. Rush timelines are possible — ask us. We won't sacrifice conversion-critical research and review to ship faster.",
  },
  {
    question: "What's your process for writing the copy?",
    answer: "We start with voice-of-customer research — customer reviews, support tickets, sales call recordings, and competitor positioning. Copy is written to use your customer's exact language, not marketing speak. Every headline addresses a specific objection or outcome your buyer cares about.",
  },
  {
    question: "Do you design the page, build it, or both?",
    answer: "Both. We deliver a complete, live landing page — design, copy, and development. We build in your existing tech stack (WordPress, Webflow, Shopify, custom HTML) or standalone if you prefer. You own all files.",
  },
  {
    question: "Will the landing page work with our existing tools?",
    answer: "Yes. We integrate with your CRM, email platform, analytics, and tracking tools as part of the build. We also set up GA4 conversion tracking and any A/B testing tool you use — so you're ready to test from day one.",
  },
  {
    question: "What makes a landing page 'conversion optimized' vs just well designed?",
    answer: "A well-designed page looks good. A conversion-optimized page is built around how buyers make decisions — addressing objections before they arise, placing social proof at maximum anxiety points, using one primary CTA with zero distractions, and loading in under 2 seconds on mobile. Design serves conversion, not the other way around.",
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteURL}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Landing Page Design', item: `${siteURL}/services/landing-page-design/` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Landing Page Design',
  description: 'Landing pages designed around buyer psychology and A/B tested to maximise conversion. Message match, mobile-first, 95+ PageSpeed. Built to convert from day one.',
  provider: { '@type': 'Organization', name: 'grow-conversions.com', url: siteURL },
  serviceType: 'Landing Page Design & Conversion Rate Optimization',
  areaServed: 'Worldwide',
};
---

<BaseLayout
  title="Landing Page Design — We Build It, Test It, Until It Converts"
  description="Landing pages designed around buyer psychology, not aesthetics. Every element is A/B tested. We've 4x'd conversion rates on pages clients thought were 'fine'."
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <div class="service-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumbs__separator" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumbs__separator" aria-hidden="true">/</span>
        <span class="breadcrumbs__current" aria-current="page">Landing Page Design</span>
      </nav>
      <span class="section-label">Service</span>
      <h1 class="service-hero__title">Landing Pages That Convert — Not Just Look Good</h1>
      <p class="service-hero__subtitle">
        Beautiful doesn't mean effective. We build landing pages that are engineered for conversion —
        from the headline to the thank-you page.
      </p>
      <div class="service-hero__actions">
        <a href="/contact/" class="btn btn--primary btn--lg">Get a Landing Page Quote</a>
        <div class="service-hero__proof">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Delivered in 10–14 days · 95+ PageSpeed · Built to A/B test</span>
        </div>
      </div>
    </div>
  </div>

  <!-- What makes us different -->
  <section class="section">
    <div class="container">
      <span class="section-label">Our Approach</span>
      <h2 class="section-title">What Makes Our Landing Pages Different</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-12);">
        Every page we build starts with buyer psychology research — not a template.
      </p>
      <div class="features-grid">
        {[
          { title: 'Psychology-First Copy', desc: 'Every word is written to address a specific objection or pain point. We use customer voice-of-data research to write copy that resonates — in your buyer\'s exact language.' },
          { title: 'Message Match', desc: 'Your ad says X, your landing page says X. No disconnect means lower bounce rates and higher conversions from the moment visitors land.' },
          { title: 'Above-the-Fold Mastery', desc: 'The first 5 seconds determine whether visitors stay or leave. We obsess over above-the-fold clarity, hierarchy, and CTA placement.' },
          { title: 'Mobile-First Build', desc: 'Over 60% of traffic is mobile. We design mobile-first, then expand to desktop — not the other way around.' },
          { title: 'Speed Optimized', desc: 'Every second of load time costs conversions. Our landing pages score 95+ on PageSpeed Insights on both mobile and desktop.' },
          { title: 'Built to Test', desc: 'Every landing page ships with a testing roadmap. Version 1 is just the start — we plan the A/B tests before we write a single line of code.' },
        ].map(({ title, desc }) => (
          <div class="card">
            <h3 class="card__title">{title}</h3>
            <p class="card__body">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div class="container">
      <span class="section-label">The Process</span>
      <h2 class="section-title">How We Build a Conversion Landing Page</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-12);">
        From research to live — a process built to maximise conversion from the start.
      </p>
      <div class="process-grid">
        {[
          { step: '1', title: 'Research', desc: 'Customer reviews, support tickets, sales call analysis, and competitor teardowns. We understand your buyer before we write a single word.' },
          { step: '2', title: 'Strategy', desc: 'Message hierarchy, CTA placement, social proof strategy, and objection map. Every element has a job before it has a design.' },
          { step: '3', title: 'Copy & Wire', desc: 'Headline, sub-headline, body copy, and CTA written first. Wireframe built around the copy — not the other way around.' },
          { step: '4', title: 'Design & Build', desc: 'Visual design applied to the wireframe. Developed in your tech stack. Integrated with your analytics and CRM.' },
          { step: '5', title: 'Test & Iterate', desc: 'Delivered with a prioritised A/B test roadmap. We track results and improve — version 1 is the beginning, not the end.' },
        ].map(({ step, title, desc }) => (
          <div class="process-step-card">
            <div class="process-step-card__number">{step}</div>
            <h3 class="process-step-card__title">{title}</h3>
            <p class="process-step-card__desc">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog resource link -->
  <section class="section">
    <div class="container">
      <div class="resource-callout">
        <div>
          <span class="section-label">Free Guide</span>
          <h2 class="resource-callout__title">18 Rules for Landing Pages That Convert</h2>
          <p class="resource-callout__desc">
            Before we build your page, read the 18 principles behind every high-converting landing page
            we've ever built. The same rules we use, explained in full — with examples.
          </p>
          <a href="/blog/landing-page-best-practices/" class="btn btn--secondary">
            Read: Landing Page Best Practices (18 Rules)
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">Landing Page Design Questions, Answered</h2>
      <div class="faq-list" style="margin-top: var(--space-10);">
        {faqs.map(({ question, answer }) => (
          <details class="faq-item">
            <summary>
              <span>{question}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </summary>
            <div class="faq-answer">{answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA
    title="Let's Build Your Highest-Converting Landing Page"
    subtitle="Tell us about your offer and audience. We'll show you exactly how we'd design the page and what we'd test first."
    ctaText="Get a Free Landing Page Review"
  />
</BaseLayout>

<style>
  .service-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0;
  }
  .service-hero__title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    max-width: 800px;
    margin: var(--space-4) 0;
  }
  .service-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }
  .service-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .service-hero__proof {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
  }
  .process-step-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-align: center;
  }
  .process-step-card__number {
    width: 40px; height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; color: white; margin: 0 auto var(--space-4);
    font-size: var(--text-lg);
  }
  .process-step-card__title { font-size: var(--text-base); font-weight: 700; margin-bottom: var(--space-3); }
  .process-step-card__desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; }
  .resource-callout {
    background: linear-gradient(135deg, var(--color-accent-light), rgba(235,247,238,0.3));
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-12);
  }
  .resource-callout__title { font-size: var(--text-2xl); font-weight: 800; letter-spacing: -0.03em; margin: var(--space-3) 0; }
  .resource-callout__desc { color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-6); max-width: 600px; }
  .faq-list { border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--color-border); background: var(--color-white); }
  .faq-item { border-bottom: 1px solid var(--color-border); padding-inline: var(--space-8); }
  .faq-item:last-child { border-bottom: none; }
  .faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-6); font-weight: 600; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-answer { padding-bottom: var(--space-7); color: var(--color-text-muted); line-height: 1.7; }

  @media (max-width: 1024px) { .process-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) {
    .process-grid { grid-template-columns: 1fr; }
    .features-grid { grid-template-columns: 1fr; }
    .resource-callout { padding: var(--space-8); }
  }
</style>
