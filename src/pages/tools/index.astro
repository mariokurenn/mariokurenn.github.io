---
import BaseLayout from '@/layouts/BaseLayout.astro';

const siteURL = 'https://grow-conversions.com';

const tools = [
  {
    href: '/tools/conversion-rate-calculator/',
    icon: '%',
    title: 'Conversion Rate Calculator',
    description: 'Calculate your CVR instantly and see how much additional revenue each percentage point improvement is worth.',
    tags: ['CVR', 'Revenue Impact', 'Benchmarks'],
  },
  {
    href: '/tools/ab-test-sample-size-calculator/',
    icon: 'n',
    title: 'A/B Test Sample Size Calculator',
    description: 'Find out exactly how many visitors you need per variant before your test results can be trusted.',
    tags: ['Statistics', 'A/B Testing', 'MDE'],
  },
  {
    href: '/tools/ab-test-duration-calculator/',
    icon: '⚡',
    title: 'A/B Test Duration Calculator',
    description: 'Calculate how many days to run your test given your traffic level, baseline CVR, and target improvement.',
    tags: ['Test Duration', 'A/B Testing', 'Planning'],
  },
  {
    href: '/tools/cart-abandonment-rate-calculator/',
    icon: '🛒',
    title: 'Cart Abandonment Calculator',
    description: 'See exactly how much revenue cart abandonment is costing you monthly and annually — and what recovery is worth.',
    tags: ['Ecommerce', 'Cart Recovery', 'Revenue'],
  },
  {
    href: '/tools/cro-roi-calculator/',
    icon: '€',
    title: 'CRO ROI Calculator',
    description: 'Quantify the revenue impact of improving your conversion rate before committing to a CRO programme.',
    tags: ['ROI', 'Revenue', 'Business Case'],
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'CRO Tools', item: `${siteURL}/tools/` },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free CRO Calculators & Tools',
  description: 'Free conversion rate optimization calculators. Calculate CVR, A/B test sample size, test duration, cart abandonment revenue loss, and CRO ROI.',
  url: `${siteURL}/tools/`,
};
---

<BaseLayout
  title="Free CRO Calculators & Tools — Conversion Rate, A/B Test, Cart Abandonment"
  description="Free conversion rate optimization calculators. Calculate your CVR, A/B test sample size, test duration, cart abandonment costs, and CRO ROI — instantly, no sign-up required."
  jsonLd={[breadcrumbSchema, collectionSchema]}
>
  <div class="tools-page">
    <div class="tools-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">CRO Tools</span>
        </nav>
        <h1 class="tools-hero__title">Free CRO Calculators</h1>
        <p class="tools-hero__subtitle">
          Five calculators built for marketers and founders running conversion rate optimization programmes.
          No sign-up. No email gate. Just the numbers.
        </p>
      </div>
    </div>

    <div class="container tools-grid-wrap">
      <div class="tools-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="tool-card">
            <div class="tool-card__icon" aria-hidden="true">{tool.icon}</div>
            <div class="tool-card__body">
              <h2 class="tool-card__title">{tool.title}</h2>
              <p class="tool-card__desc">{tool.description}</p>
              <div class="tool-card__tags">
                {tool.tags.map((tag) => (
                  <span class="tool-card__tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="tool-card__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="tools-cta-block">
        <p class="tools-cta-block__text">
          Need more than a calculator? A free CRO audit identifies every conversion blocker on your site — with a prioritized fix list and estimated revenue impact.
        </p>
        <a href="/contact/" class="btn btn--primary">Get a Free CRO Audit</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tools-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0 var(--space-10);
  }

  .tools-hero__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .tools-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 580px;
    line-height: 1.6;
  }

  .tools-grid-wrap {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .tool-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-white);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
    position: relative;
  }

  .tool-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 24px rgba(26, 127, 60, 0.10);
    transform: translateY(-2px);
  }

  .tool-card__icon {
    width: 48px;
    height: 48px;
    background: var(--color-accent-light);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .tool-card__body {
    flex: 1;
    min-width: 0;
  }

  .tool-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: var(--space-2);
  }

  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: var(--space-3);
  }

  .tool-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tool-card__tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-light);
    border-radius: var(--radius-full);
    padding: 2px 8px;
  }

  .tool-card__arrow {
    font-size: var(--text-lg);
    color: var(--color-text-subtle);
    transition: color var(--transition-fast), transform var(--transition-fast);
    flex-shrink: 0;
    align-self: center;
  }

  .tool-card:hover .tool-card__arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  .tools-cta-block {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-10);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .tools-cta-block__text {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 520px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .tools-grid { grid-template-columns: 1fr; }
    .tools-cta-block { flex-direction: column; align-items: flex-start; }
  }
</style>
