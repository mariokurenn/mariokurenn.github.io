---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search — CRO Guides, A/B Testing & Conversion Optimization"
  description="Search grow-conversions.com — find CRO guides, A/B testing tutorials, landing page best practices, and conversion rate optimization resources."
>
  <div class="search-page">
    <div class="search-page__header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">Search</span>
        </nav>
        <h1 class="search-page__title">Search</h1>
        <p class="search-page__subtitle">Search across all CRO guides, A/B testing articles, glossary terms, and service pages.</p>
      </div>
    </div>
    <div class="container search-page__content">
      <div id="search"></div>
    </div>
  </div>
</BaseLayout>

<script>
  // Load Pagefind UI dynamically (files only exist after build)
  function initSearch() {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);

    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      // @ts-ignore
      const ui = new PagefindUI({
        element: '#search',
        showImages: true,
        showSubResults: false,
        excerptLength: 30,
        resetStyles: false,
      });
      const q = new URLSearchParams(window.location.search).get('q');
      if (q) ui.triggerSearch(q);
    };
    script.onerror = () => {
      const el = document.getElementById('search');
      if (el) el.innerHTML = '<p class="search-unavailable">Search index is building — check back after the next deploy.</p>';
    };
    document.head.appendChild(script);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>

<style>
  .search-page__header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-12) 0 var(--space-8);
  }

  .search-page__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .search-page__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 560px;
  }

  .search-page__content {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
    max-width: 760px;
  }

  .search-unavailable {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    padding: var(--space-8) 0;
  }

  /* Override Pagefind UI to match brand */
  :root {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: #1A7F3C;
    --pagefind-ui-text: var(--color-text, #1e293b);
    --pagefind-ui-background: var(--color-white, #ffffff);
    --pagefind-ui-border: var(--color-border, #e2e8f0);
    --pagefind-ui-tag: var(--color-surface, #f8fafc);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-font: inherit;
  }
</style>
