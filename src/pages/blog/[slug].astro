---
import { getCollection } from 'astro:content';
import BlogLayout from '@/layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

  return sorted.map((post, index) => {
    // Related: same category, not current, up to 3
    const related = sorted
      .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
      .slice(0, 3);

    // Prev/Next by date (sorted descending, so prev = higher index = older)
    const prevPost = sorted[index + 1]
      ? { slug: sorted[index + 1].slug, title: sorted[index + 1].data.title }
      : null;
    const nextPost = sorted[index - 1]
      ? { slug: sorted[index - 1].slug, title: sorted[index - 1].data.title }
      : null;

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts: related, prevPost, nextPost },
    };
  });
}

const { post, relatedPosts, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

// Estimate reading time (avg 200 words/min)
const wordCount = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BlogLayout
  post={post}
  readingTime={readingTime}
  relatedPosts={relatedPosts}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogLayout>
