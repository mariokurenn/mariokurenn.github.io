  jsonLd={breadcrumbSchema}
>
  <div class="blog-index">
    <!-- Header -->
    <div class="blog-index__header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">Blog</span>
        </nav>
        <h1 class="blog-index__title">CRO Insights & Guides</h1>
        <p class="blog-index__subtitle">
          Actionable conversion rate optimization strategies, A/B testing frameworks, and landing page
          best practices — written for marketers and founders who want results, not fluff.
        </p>

      </div>
    </div>

    <!-- Sticky category filter -->
    <div class="blog-categories-bar">
      <div class="container">
        <nav class="blog-categories" aria-label="Filter by category">
          {categories.map((cat) => (
            <a
              href={cat === 'All' ? '/blog/' : `/blog/category/${cat.toLowerCase().replace(/\s+/g, '-').replace(/\//g, '-')}/`}
              class:list={['blog-category-link', { 'blog-category-link--active': cat === 'All' }]}
            >
              {cat}
            </a>
          ))}
        </nav>
      </div>
    </div>

    <!-- Posts grid -->
    <div class="blog-index__content container">
      {posts.length > 0 ? (
        <div class="blog-posts-grid">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.slug}/`}
              class:list={['blog-card', { 'blog-card--featured': i === 0 }]}
            >
              <div class="blog-card__image">
                {post.data.image
                  ? <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="lazy" decoding="async" width="800" height="420" />
                  : <div class="blog-card__image-placeholder" aria-hidden="true"></div>
                }
              </div>
              <div class="blog-card__body">
                <p class="blog-card__category">{post.data.category}</p>
                <h2 class="blog-card__title">{post.data.title}</h2>
                <p class="blog-card__excerpt">{post.data.description}</p>
                <div class="blog-card__meta">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {formatDate(post.data.publishDate)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span class="blog-card__author">{post.data.author}</span>
                  <span aria-hidden="true">·</span>
                  <span>{Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 200))} min read</span>
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <>
                      <span aria-hidden="true">·</span>
                      <span class="blog-card__tag">{tag}</span>
                    </>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="blog-index__empty">No posts published yet. Check back soon!</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index__header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0 var(--space-8);
  }

  .blog-index__title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
    margin-top: var(--space-4);
  }

  .blog-index__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.6;
  }

  .blog-categories-bar {
    position: sticky;
    top: 69px;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  .blog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-category-link {
    display: inline-block;
    padding: 0.375rem 1rem;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    background: var(--color-primary);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .blog-category-link:hover,
  .blog-category-link--active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .blog-index__content {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .blog-posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* Featured first post spans full width */
  .blog-card--featured {
    grid-column: 1 / -1;
    flex-direction: row;
  }

  .blog-card--featured .blog-card__image {
    flex: 0 0 45%;
    aspect-ratio: auto;
    min-height: 280px;
  }

  .blog-card--featured .blog-card__image-placeholder {
    height: 100%;
  }

  .blog-card--featured .blog-card__title {
    font-size: var(--text-2xl);
  }

  .blog-card--featured .blog-card__excerpt {
    font-size: var(--text-base);
    -webkit-line-clamp: 3;
  }

  .blog-card__image-placeholder {
    width: 100%;
    height: 200px;
    background: linear-gradient(135deg, var(--color-surface-light) 0%, var(--color-border) 100%);
  }

  .blog-card__author {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .blog-card__author:hover { text-decoration: underline; }

  .blog-card__tag {
    background: var(--color-surface-light);
    border-radius: var(--radius-full);
    padding: 0.1em 0.5em;
    font-size: 0.75em;
  }

  .blog-index__empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-16) 0;
  }

  @media (max-width: 900px) {
    .blog-posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .blog-card--featured {
      flex-direction: column;
    }

    .blog-card--featured .blog-card__image {
      flex: none;
      min-height: 200px;
    }
  }

  @media (max-width: 640px) {
    .blog-posts-grid {
      grid-template-columns: 1fr;
    }

    .blog-card--featured {
      grid-column: 1;
    }
  }
</style>
