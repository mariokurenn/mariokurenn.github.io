---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  const categories = [...new Set(allPosts.map((p) => p.data.category))];

  return categories.map((category) => {
    const slug = category.toLowerCase().replace(/\s+/g, '-').replace(/\//g, '-');
    const posts = allPosts.filter((p) => p.data.category === category)
      .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
    return {
      params: { category: slug },
      props: { category, posts },
    };
  });
}

const { category, posts } = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---

<BaseLayout
  title={`${category} — CRO Blog`}
  description={`Articles about ${category} — conversion rate optimization insights backed by data and real-world testing experience.`}
>
  <div class="blog-index">
    <div class="blog-index__header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">{category}</span>
        </nav>
        <h1 class="blog-index__title">{category}</h1>
        <p class="blog-index__subtitle">{posts.length} article{posts.length !== 1 ? 's' : ''} in this category</p>
      </div>
    </div>

    <div class="blog-index__content container">
      {posts.length > 0 ? (
        <div class="grid-3">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="blog-card">
              <div class="blog-card__image">
                <div style="width:100%;height:180px;background:linear-gradient(135deg,var(--color-surface-light),var(--color-border))"></div>
              </div>
              <div class="blog-card__body">
                <p class="blog-card__category">{post.data.category}</p>
                <h2 class="blog-card__title">{post.data.title}</h2>
                <p class="blog-card__excerpt">{post.data.description}</p>
                <div class="blog-card__meta">
                  <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{post.data.author}</span>
                  <span aria-hidden="true">·</span>
                  <span>{Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 200))} min read</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p style="color:var(--color-text-muted);padding:var(--space-16) 0;text-align:center;">No posts in this category yet.</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index__header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0 var(--space-10);
  }

  .blog-index__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: var(--space-4) 0 var(--space-3);
  }

  .blog-index__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .blog-index__content {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }
</style>
