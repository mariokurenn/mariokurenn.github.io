---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const terms = await getCollection('glossary');
  return terms.map((entry) => ({
    params: { term: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'glossary'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { term, shortDefinition, category, difficulty, relatedTerms, faqs, publishDate, updatedDate } = entry.data;

const siteURL = 'https://conversionrate-expert.com';
const pageURL = `${siteURL}/cro-glossary/${entry.slug}/`;
const authorURL = `${siteURL}/author/mario-kuren/`;

const allTerms = await getCollection('glossary');
const related = allTerms.filter((t) => relatedTerms.includes(t.slug) || relatedTerms.includes(t.slug.replace(/-/g, '')));

const definedTermSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term,
  description: shortDefinition,
  url: pageURL,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'CRO Glossary',
    url: `${siteURL}/cro-glossary/`,
  },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${term}: Definition, Examples & CRO Impact`,
  description: shortDefinition,
  url: pageURL,
  author: {
    '@type': 'Person',
    name: 'Mario Kuren',
    url: authorURL,
    jobTitle: 'CRO Specialist & Founder',
  },
  publisher: {
    '@type': 'Organization',
    name: 'conversionrate-expert.com',
    url: siteURL,
    logo: { '@type': 'ImageObject', url: `${siteURL}/favicon.svg` },
  },
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'CRO Glossary', item: `${siteURL}/cro-glossary/` },
    { '@type': 'ListItem', position: 3, name: term, item: pageURL },
  ],
};

const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageURL,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.term-definition', '.term-faq__a'],
  },
};

const schemas = [definedTermSchema, articleSchema, breadcrumbSchema, speakableSchema, ...(faqSchema ? [faqSchema] : [])];

const difficultyLabel = { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced' }[difficulty];
---

<BaseLayout
  title={`${term}: Definition, Examples & CRO Impact`}
  description={shortDefinition}
  jsonLd={schemas}
>
  <article class="term-page">
    <!-- Header -->
    <div class="term-header">
      <div class="container ">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <a href="/cro-glossary/">CRO Glossary</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">{term}</span>
        </nav>

        <div class="term-header__badges">
          <span class="badge badge--accent">{category}</span>
          <span class={`badge term-diff term-diff--${difficulty}`}>{difficultyLabel}</span>
        </div>

        <h1 class="term-header__title">{term}</h1>

        <!-- Definition block — extracted by AI systems -->
        <p class="term-definition" itemprop="description">
          {shortDefinition}
        </p>

        <div class="term-header__meta">
          <span>
            By <a href="/author/mario-kuren/" class="term-header__author">Mario Kuren</a>
          </span>
          <span aria-hidden="true">·</span>
          <time datetime={publishDate.toISOString()}>
            {publishDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
          </time>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime={updatedDate.toISOString()}>
                {updatedDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
              </time></span>
            </>
          )}
        </div>
      </div>
    </div>

    <!-- Content layout -->
    <div class="container term-layout">
      <!-- Main content -->
      <div class="term-body">
        <div class="prose">
          <Content />
        </div>

        <!-- FAQ section -->
        {faqs && faqs.length > 0 && (
          <section class="term-faq" aria-labelledby="term-faq-heading">
            <h2 id="term-faq-heading">Frequently Asked Questions</h2>
            <div class="term-faq__list">
              {faqs.map(({ question, answer }) => (
                <details class="term-faq__item">
                  <summary class="term-faq__q">{question}</summary>
                  <p class="term-faq__a">{answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Related terms -->
        {related.length > 0 && (
          <section class="term-related" aria-labelledby="related-heading">
            <h2 id="related-heading">Related Terms</h2>
            <div class="term-related__grid">
              {related.map((t) => (
                <a href={`/cro-glossary/${t.slug}/`} class="term-related__card">
                  <span class="term-related__name">{t.data.term}</span>
                  <span class="term-related__def">{t.data.shortDefinition}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Back to glossary -->
        <div class="term-back">
          <a href="/cro-glossary/" class="btn btn--secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to CRO Glossary
          </a>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="term-sidebar" aria-label="Free audit offer">
        <div class="term-sidebar__cta">
          <p class="term-sidebar__eyebrow">Apply this in your funnel</p>
          <h3 class="term-sidebar__title">Get a Free CRO Audit</h3>
          <p class="term-sidebar__body">
            Find out exactly what's costing you conversions — our free 47-point audit covers analytics, UX, copy, trust signals, and funnel architecture.
          </p>
          <a href="/contact/" class="btn btn--primary term-sidebar__btn">
            Book Free Audit
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <p class="term-sidebar__note">Free · No commitment · 24h response</p>
        </div>

        <div class="term-sidebar__more">
          <p class="term-sidebar__more-title">More in {category}</p>
          {allTerms
            .filter((t) => t.data.category === category && t.slug !== entry.slug)
            .slice(0, 5)
            .map((t) => (
              <a href={`/cro-glossary/${t.slug}/`} class="term-sidebar__link">
                {t.data.term} →
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .term-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-12) 0 var(--space-10);
  }

  .term-header__inner { max-width: 760px; }

  .term-header__badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .term-diff { font-size: var(--text-xs); font-weight: 700; }
  .term-diff--beginner { background: #F0FDF4; color: #15803D; border: 1px solid #BBF7D0; }
  .term-diff--intermediate { background: #FFF7ED; color: #C2410C; border: 1px solid #FED7AA; }
  .term-diff--advanced { background: #FDF2F8; color: #9D174D; border: 1px solid #FBCFE8; }

  .term-header__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
    line-height: 1.1;
  }

  /* The extractable definition block */
  .term-definition {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 680px;
    margin-bottom: var(--space-5);
    padding: var(--space-5) var(--space-6);
    background: var(--color-white);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .term-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    flex-wrap: wrap;
  }

  .term-header__author {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .term-header__author:hover { text-decoration: underline; }

  /* Layout */
  .term-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-16);
    align-items: start;
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  /* Body */
  .term-body { min-width: 0; }

  /* FAQ */
  .term-faq {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .term-faq h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-heading);
    margin-bottom: var(--space-6);
    letter-spacing: -0.02em;
  }

  .term-faq__list { display: flex; flex-direction: column; gap: var(--space-2); }

  .term-faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .term-faq__item[open] { border-color: var(--color-border-accent); }

  .term-faq__q {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-heading);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    background: var(--color-surface);
    transition: background var(--transition-fast);
  }

  .term-faq__q::-webkit-details-marker { display: none; }

  .term-faq__q::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .term-faq__item[open] .term-faq__q::after { transform: rotate(45deg); }
  .term-faq__q:hover { background: var(--color-accent-subtle); }

  .term-faq__a {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    padding: var(--space-4) var(--space-5);
    margin: 0;
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  /* Related terms */
  .term-related {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .term-related h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-5);
  }

  .term-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .term-related__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .term-related__card:hover {
    border-color: var(--color-border-accent);
    background: var(--color-accent-subtle);
  }

  .term-related__name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-heading);
  }

  .term-related__def {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .term-back {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  /* Sidebar */
  .term-sidebar {
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .term-sidebar__cta {
    background: var(--color-accent-light);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .term-sidebar__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .term-sidebar__title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .term-sidebar__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .term-sidebar__btn { width: 100%; justify-content: center; }

  .term-sidebar__note {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-align: center;
    margin-top: var(--space-3);
  }

  .term-sidebar__more {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .term-sidebar__more-title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
  }

  .term-sidebar__link {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
    transition: color var(--transition-fast);
  }

  .term-sidebar__link:last-child { border-bottom: none; }
  .term-sidebar__link:hover { color: var(--color-accent-hover); }

  @media (max-width: 900px) {
    .term-layout {
      grid-template-columns: 1fr;
    }

    .term-sidebar {
      position: static;
      order: -1;
    }

    .term-sidebar__more { display: none; }
  }
</style>
