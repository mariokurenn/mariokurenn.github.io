---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTerms = await getCollection('glossary');
const sorted = allTerms.sort((a, b) => a.data.term.localeCompare(b.data.term));

const siteURL = 'https://grow-conversions.com';

const categories = ['Metrics', 'A/B Testing', 'Analytics', 'CRO Strategy', 'Psychology', 'Technical'] as const;

const byCategory = categories.map((cat) => ({
  category: cat,
  terms: sorted.filter((t) => t.data.category === cat),
})).filter((g) => g.terms.length > 0);

const glossarySchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'CRO Glossary — Conversion Rate Optimization Terms',
  description: 'A comprehensive glossary of conversion rate optimization terms, A/B testing concepts, and analytics definitions.',
  url: `${siteURL}/cro-glossary/`,
  hasDefinedTerm: sorted.map((term) => ({
    '@type': 'DefinedTerm',
    name: term.data.term,
    description: term.data.shortDefinition,
    url: `${siteURL}/cro-glossary/${term.slug}/`,
    inDefinedTermSet: `${siteURL}/cro-glossary/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    { '@type': 'ListItem', position: 2, name: 'CRO Glossary', item: `${siteURL}/cro-glossary/` },
  ],
};
---

<BaseLayout
  title="CRO Glossary: Conversion Optimization Terms"
  description="Complete glossary of conversion rate optimization terms. Clear definitions of A/B testing, conversion rate, statistical significance, heatmaps, and 50+ more CRO concepts."
  jsonLd={[glossarySchema, breadcrumbSchema]}
>
  <div class="glossary-page">
    <div class="glossary-header">
      <div class="container ">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">CRO Glossary</span>
        </nav>
        <span class="section-label">Reference</span>
        <h1 class="glossary-header__title">CRO Glossary</h1>
        <p class="glossary-header__sub">
          Clear, practical definitions of every conversion rate optimization term you'll encounter —
          from A/B testing and statistical significance to heatmaps, funnels, and beyond.
          Written by Mario Kuren, CRO specialist with 800+ A/B tests run.
        </p>
        <div class="glossary-header__stats">
          <span><strong>{sorted.length}</strong> terms defined</span>
          <span aria-hidden="true">·</span>
          <span><strong>{categories.length}</strong> categories</span>
          <span aria-hidden="true">·</span>
          <span>Updated {new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
        </div>
      </div>
    </div>

    <div class="container glossary-content">
      <!-- Category nav -->
      <nav class="glossary-cats" aria-label="Glossary categories">
        {byCategory.map(({ category }) => (
          <a href={`#cat-${category.toLowerCase().replace(/\s+/g, '-').replace(/\//g, '-')}`} class="glossary-cat-link">
            {category}
          </a>
        ))}
      </nav>

      <!-- Terms by category -->
      {byCategory.map(({ category, terms }) => {
        const catId = `cat-${category.toLowerCase().replace(/\s+/g, '-').replace(/\//g, '-')}`;
        return (
          <section class="glossary-section" id={catId} aria-labelledby={`${catId}-heading`}>
            <h2 class="glossary-section__title" id={`${catId}-heading`}>{category}</h2>
            <div class="glossary-grid">
              {terms.map((term) => (
                <a href={`/cro-glossary/${term.slug}/`} class="glossary-card">
                  <div class="glossary-card__top">
                    <h3 class="glossary-card__term">{term.data.term}</h3>
                    <span class={`glossary-card__diff glossary-card__diff--${term.data.difficulty}`}>
                      {term.data.difficulty}
                    </span>
                  </div>
                  <p class="glossary-card__def">{term.data.shortDefinition}</p>
                  <span class="glossary-card__link" aria-hidden="true">
                    Read definition →
                  </span>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      <!-- CTA -->
      <div class="glossary-cta">
        <div class="glossary-cta__inner">
          <h2 class="glossary-cta__title">Turn Knowledge Into Revenue</h2>
          <p class="glossary-cta__sub">Understanding these concepts is step one. Applying them systematically to your funnel is where the revenue lives. Our free audit shows you exactly where to start.</p>
          <a href="/contact/" class="btn btn--primary">
            Get a Free CRO Audit
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .glossary-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0 var(--space-12);
  }

  .glossary-header__inner { max-width: 720px; }

  .glossary-header__title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: var(--space-3) 0 var(--space-4);
  }

  .glossary-header__sub {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-5);
  }

  .glossary-header__stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .glossary-content {
    padding-top: var(--space-10);
    padding-bottom: var(--space-20);
  }

  /* Category nav */
  .glossary-cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-12);
    position: sticky;
    top: 69px;
    z-index: 10;
    background: var(--color-bg);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    margin-left: calc(var(--space-6) * -1);
    margin-right: calc(var(--space-6) * -1);
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .glossary-cat-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-light);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-full);
    padding: 0.35rem 1rem;
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .glossary-cat-link:hover {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  /* Section */
  .glossary-section {
    margin-bottom: var(--space-16);
    scroll-margin-top: var(--space-8);
  }

  .glossary-section__title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-border);
  }

  /* Grid */
  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  /* Card */
  .glossary-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .glossary-card:hover {
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-accent);
    transform: translateY(-2px);
  }

  .glossary-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .glossary-card__term {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.01em;
  }

  .glossary-card__diff {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .glossary-card__diff--beginner {
    background: #F0FDF4;
    color: #15803D;
    border: 1px solid #BBF7D0;
  }

  .glossary-card__diff--intermediate {
    background: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FED7AA;
  }

  .glossary-card__diff--advanced {
    background: #FDF2F8;
    color: #9D174D;
    border: 1px solid #FBCFE8;
  }

  .glossary-card__def {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .glossary-card__link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    margin-top: var(--space-2);
  }

  /* Bottom CTA */
  .glossary-cta {
    margin-top: var(--space-16);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-16);
  }

  .glossary-cta__inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .glossary-cta__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .glossary-cta__sub {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  @media (max-width: 640px) {
    .glossary-grid { grid-template-columns: 1fr; }
    .glossary-header__stats { flex-wrap: wrap; }
  }
</style>
