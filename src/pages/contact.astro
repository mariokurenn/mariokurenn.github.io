---
import BaseLayout from '@/layouts/BaseLayout.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact conversionrate-expert.com',
  url: 'https://conversionrate-expert.com/contact/',
};
---

<BaseLayout
  title="Contact — Book Your Free CRO Audit"
  description="Book a free CRO audit or strategy call. We'll analyze your site, find what's killing your conversions, and give you a prioritized action plan — free."
  jsonLd={contactSchema}
>
  <div class="contact-page">
    <div class="contact-header">
      <div class="container contact-header__inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          <span class="breadcrumbs__current" aria-current="page">Contact</span>
        </nav>
        <h1 class="contact-header__title">Get Your Free 47-Point CRO Audit</h1>
        <p class="contact-header__subtitle">
          Tell us about your site and goals. We'll review your funnel, identify your biggest revenue leaks,
          and share a prioritised action plan — completely free, no strings attached, response within 24 hours.
        </p>
      </div>
    </div>

    <div class="contact-content container">
      <div class="contact-grid">
        <!-- Form -->
        <div class="contact-form-wrap">
          <form
            class="contact-form"
            action="https://formsubmit.co/your@email.com"
            method="POST"
            aria-label="Contact form"
          >
            <!-- FormSubmit config -->
            <input type="hidden" name="_subject" value="New CRO Audit Request — conversionrate-expert.com" />
            <input type="hidden" name="_next" value="https://conversionrate-expert.com/thank-you/" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" style="display:none" tabindex="-1" aria-hidden="true" />

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Your Name *</label>
                <input
                  class="form-input"
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Jane Smith"
                  required
                  autocomplete="name"
                />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email Address *</label>
                <input
                  class="form-input"
                  type="email"
                  id="email"
                  name="email"
                  placeholder="jane@company.com"
                  required
                  autocomplete="email"
                />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="website">Website URL *</label>
              <input
                class="form-input"
                type="url"
                id="website"
                name="website"
                placeholder="https://yourwebsite.com"
                required
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="traffic">Monthly Traffic (approx.)</label>
              <select class="form-select" id="traffic" name="traffic">
                <option value="">Select range</option>
                <option>Under 1,000 visitors</option>
                <option>1,000 – 10,000 visitors</option>
                <option>10,000 – 50,000 visitors</option>
                <option>50,000 – 200,000 visitors</option>
                <option>200,000+ visitors</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="message">What's your biggest conversion challenge?</label>
              <textarea
                class="form-textarea"
                id="message"
                name="message"
                placeholder="e.g. Our checkout abandonment rate is 78% and we don't know why. We're spending $20K/mo on ads but CVR hasn't moved in 6 months..."
                rows="5"
              ></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg contact-form__submit">
              Request My Free Audit →
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>

            <p class="contact-form__privacy">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0110 0v4"/>
              </svg>
              Your information is private. We never share or sell your data.
            </p>
          </form>
        </div>

        <!-- Info sidebar -->
        <aside class="contact-info" aria-label="What to expect">
          <h2 class="contact-info__title">What Happens Next</h2>
          <ol class="contact-steps">
            {[
              { title: 'We review your site', desc: 'Within 24 hours we do a quick review of your site and analytics before the call.' },
              { title: 'You get a calendar invite', desc: 'We\'ll send a Calendly link to pick a time for a 30-minute strategy call.' },
              { title: 'Free audit walkthrough', desc: 'On the call, we share our findings and the 3–5 biggest opportunities we see.' },
              { title: 'You decide what\'s next', desc: 'No pressure. If we\'re a fit, we\'ll discuss engagement options. If not, the audit is yours to keep.' },
            ].map(({ title, desc }, i) => (
              <li class="contact-step">
                <div class="contact-step__number" aria-hidden="true">{i + 1}</div>
                <div>
                  <h3 class="contact-step__title">{title}</h3>
                  <p class="contact-step__desc">{desc}</p>
                </div>
              </li>
            ))}
          </ol>

          <div class="contact-guarantee">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <div>
              <p class="contact-guarantee__title">100% Free. Zero Obligation.</p>
              <p class="contact-guarantee__text">We offer free audits because they work. Our close rate from free audits is high because we genuinely find valuable problems. You get real value regardless of what you decide.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0;
  }

  .contact-header__inner {
    max-width: 700px;
  }

  .contact-header__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: var(--space-4) 0;
  }

  .contact-header__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .contact-content {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: var(--space-16);
    align-items: start;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .contact-form__submit {
    width: 100%;
    justify-content: center;
  }

  .contact-form__privacy {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    justify-content: center;
  }

  /* Info sidebar */
  .contact-info__title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-6);
  }

  .contact-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .contact-step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .contact-step__number {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-step__title {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .contact-step__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .contact-guarantee {
    background: rgba(34, 197, 94, 0.06);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .contact-guarantee svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-guarantee__title {
    font-weight: 700;
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
    color: var(--color-success);
  }

  .contact-guarantee__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
